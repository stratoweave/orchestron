import testing

import stratoweave

import fleetmgr.cfs as cfs
import fleetmgr.layers.y_0 as y_0
import fleetmgr.layers.y_1_loose as y_1
import fleetmgr.sysspec as sysspec
from fleetmgr.layers.y_0 import \
    fleetmgr__fleet__device__address_entry as InputAddress, \
    fleetmgr__fleet__device__credentials as InputCredentials, \
    fleetmgr__fleet__device__mock__module_entry as InputMockModule, \
    fleetmgr__fleet__device_entry as InputDevice, \
    fleetmgr__fleet__node__credentials as NodeCredentials, \
    fleetmgr__fleet__node_entry as InputNode, \
    software__software__upgrade_campaign_entry as InputCampaign
from fleetmgr.layers.y_1_loose import \
    stratoweave_rfs__device_entry as OutputNode, \
    stratoweave_rfs__rfs__device__address__initial_credentials_entry as AddressCredentials, \
    stratoweave_rfs__rfs__device__address_entry as OutputAddress, \
    stratoweave_rfs__rfs__device__credentials__key_entry as OutputKey, \
    stratoweave_rfs__rfs__device__initial_credentials_entry as DeviceCredentials, \
    stratoweave_rfs__rfs__device__mock__module_entry as OutputMockModule, \
    stratoweave_rfs__rfs__device_entry as OutputDevice


actor _test_node_transform(t: testing.AsyncT):
    i = InputNode(
        name="flotilla-1",
        description="Stockholm flotilla",
        credentials=NodeCredentials(username="admin", password="admin"),
    )
    address = i.address.create("primary", address="127.0.0.1", port=u64(12031))

    transform: cfs.Node = cfs.Node()
    o: y_1.root = y_1.root.from_gdata(transform.transform(i).to_gdata())
    dev: OutputNode = o.device.get("flotilla-1")!
    out_address = dev.address.get("primary")!

    if dev.type != "flotilla" or dev.description != "Stockholm flotilla":
        t.failure(ValueError("flotilla identity was not preserved"))
    elif out_address.address != "127.0.0.1" or out_address.port != 12031:
        t.failure(ValueError("flotilla address was not preserved"))
    elif dev.credentials.username != "admin" or dev.credentials.password != "admin":
        t.failure(ValueError("flotilla credentials were not preserved"))
    elif o.rfs.get("flotilla-1")!.flotilla_status.enabled != True:
        t.failure(ValueError("flotilla status collector was not enabled"))
    else:
        t.success()


actor _test_campaign_transform(t: testing.AsyncT):
    inventory = y_0.root()
    inventory.fleet.device.create(
        "cpe-1",
        type="iosxe",
        shard="flotilla-1",
        credentials=InputCredentials(username="admin"),
    )
    campaign = InputCampaign(
        name="xe-upgrade",
        target_release="17.18.03a",
        image_url="https://images.example/xe.bin",
        allow_staging=True,
        device=["cpe-1"],
        admin_state="run",
    )

    transform: cfs.UpgradeCampaign = cfs.UpgradeCampaign()
    o: y_1.root = y_1.root.from_gdata(
        transform.transform(campaign, inventory.to_gdata()).to_gdata()
    )
    dev = o.rfs.get("flotilla-1")!.device.get("cpe-1")!

    if dev.software.target_release != "17.18.03a" or \
       dev.software.upgrade_campaign != "xe-upgrade" or \
       dev.software.image_url != "https://images.example/xe.bin" or \
       not dev.software.allow_staging!:
        t.failure(ValueError("campaign was not routed through the device shard"))
    else:
        t.success()


actor _test_campaign_link_routes_existing_inventory(t: testing.AsyncT):
    """A later campaign resolves and augments an existing inventory device."""
    root = y_0.root()
    root.fleet.node.create(
        "flotilla-1",
        credentials=NodeCredentials(username="admin"),
    )
    root.fleet.device.create(
        "cpe-1",
        type="iosxe",
        shard="flotilla-1",
        credentials=InputCredentials(username="admin"),
    )
    tr = stratoweave.test_main(sysspec.SYSSPEC, t.log_handler)
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_campaign(result) -> None:
        if isinstance(result, Exception):
            fail("campaign edit failed: {result}")
            return
        lower = y_1.root.from_gdata(tr.cfs.below().newsession().get_data())
        out = lower.rfs.get("flotilla-1")!.device.get("cpe-1")!
        if out.software.target_release != "17.18.03a":
            fail("linked campaign did not augment the existing inventory device")
        elif not done:
            done = True
            t.success()

    def on_inventory(result) -> None:
        if isinstance(result, Exception):
            fail("inventory edit failed: {result}")
            return
        campaign = root.software.upgrade_campaign.create(
            "xe-upgrade",
            target_release="17.18.03a",
            image_url="https://images.example/xe.bin",
            admin_state="run",
        )
        campaign.device = ["cpe-1"]
        tr.edit_config(root.to_gdata(), on_campaign)

    tr.edit_config(root.to_gdata(), on_inventory)
    after 2.0: fail("timed out waiting for linked campaign")


actor _test_device_transform(t: testing.AsyncT):
    credentials: InputCredentials = InputCredentials(
        username="netops",
        password="netops-password",
    )
    credentials.key.create("ssh-ed25519 public", private_key="private")

    i: InputDevice = InputDevice(
        name="cpe-1",
        type="iosxe",
        shard="flotilla-1",
        description="Lab CPE",
        credentials=credentials,
        approval_required=True,
    )
    address: InputAddress = i.address.create(
        "oob",
        address="192.0.2.1",
        port=u64(830),
    )
    address.initial_credentials.create((
        username="address-bootstrap",
        password="address-password",
        key="address-key",
    ))
    i.initial_credentials.create((
        username="device-bootstrap",
        password="device-password",
        key="device-key",
    ))
    i.mock.enabled = True
    module: InputMockModule = i.mock.module.create(
        "ietf-system",
        namespace="urn:ietf:params:xml:ns:yang:ietf-system",
        revision="2014-08-06",
    )
    module.feature = ["authentication", "local-users"]
    i.debug.connection = True
    i.feature_flags.runtime_schema_fetch = True

    transform: cfs.Device = cfs.Device()
    o: y_1.root = y_1.root.from_gdata(transform.transform(i).to_gdata())
    shard = o.rfs.get("flotilla-1")!
    dev: OutputDevice = shard.device.get("cpe-1")!
    out_address: OutputAddress = dev.address.get("oob")!
    address_credentials: ?AddressCredentials = out_address.initial_credentials.get((
        username="address-bootstrap",
        password="address-password",
        key="address-key",
    ))
    device_credentials: ?DeviceCredentials = dev.initial_credentials.get((
        username="device-bootstrap",
        password="device-password",
        key="device-key",
    ))
    out_key: OutputKey = dev.credentials.key.get("ssh-ed25519 public")!
    out_module: OutputMockModule = dev.mock.module.get("ietf-system")!

    if dev.type != "iosxe" or dev.description != "Lab CPE":
        t.failure(ValueError("device identity was not preserved"))
    elif out_address.address != "192.0.2.1" or out_address.port != 830:
        t.failure(ValueError("device address fields were not preserved"))
    elif address_credentials is None or device_credentials is None:
        t.failure(ValueError("initial credentials were not preserved"))
    elif dev.credentials.username != "netops" or dev.credentials.password != "netops-password":
        t.failure(ValueError("active credentials were not preserved"))
    elif out_key.private_key != "private":
        t.failure(ValueError("credential keys were not preserved"))
    elif not dev.approval_required! or not dev.mock.enabled!:
        t.failure(ValueError("device policy fields were not preserved"))
    elif out_module.namespace != "urn:ietf:params:xml:ns:yang:ietf-system" or \
         out_module.revision != "2014-08-06" or \
         out_module.feature != ["authentication", "local-users"]:
        t.failure(ValueError("mock module fields were not preserved"))
    elif not dev.debug.connection! or not dev.feature_flags.runtime_schema_fetch!:
        t.failure(ValueError("debug or feature flags were not preserved"))
    else:
        t.success()
