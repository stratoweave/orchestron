import argconf
import file
import logging
import std.xml as xml

import db as swdb
import device as swdev
import ttt as ttt
import yang.gdata as ygdata
import yang.schema as yschema
import yang.xml as yxml


def _no_yang_src(layer: int) -> list[str]:
    """Default yang_src_for_layer for sysspecs generated before YANG sources
    were plumbed through: no sources, so servers skip schema serving."""
    return []


def _resolve_yang_src(f: ?proc(int) -> list[str]) -> proc(int) -> list[str]:
    if f is not None:
        return f
    return _no_yang_src


class SysSpec(value):
    """Exportable wrapper for generated functions from sysspec.act"""
    device_types: dict[str, swdev.DeviceType]
    @property
    get_layers: proc(swdev.DeviceRegistry, ?logging.Handler, ?swdb.Store) -> ttt.Layer
    @property
    schema_for_layer: proc(int) -> yschema.DRoot
    @property
    oper_schema_for_layer: ?proc(int) -> yschema.DRoot
    @property
    yang_src_for_layer: proc(int) -> list[str]

    def __init__(self, device_types, get_layers, schema_for_layer,
                 oper_schema_for_layer: ?(proc(int) -> yschema.DRoot)=None,
                 yang_src_for_layer: ?proc(int) -> list[str] = None):
        self.device_types = device_types
        self.get_layers = get_layers
        self.schema_for_layer = schema_for_layer
        self.oper_schema_for_layer = oper_schema_for_layer
        self.yang_src_for_layer = _resolve_yang_src(yang_src_for_layer)

    def schema_for_oper_layer(self, layer: int) -> yschema.DRoot:
        get_schema = self.oper_schema_for_layer
        if get_schema is not None:
            return get_schema(layer)
        return self.schema_for_layer(layer)


class SystemSettings(value):
    startup_config_files: list[str]
    db_spec: ?str
    http_port: int
    netconf_port: int
    netconf_host_key_path: ?str
    netconf_user: str
    netconf_password: str
    udp_notif_listen_address: str
    udp_notif_receiver_address: ?str
    udp_notif_source_interface: ?str
    udp_notif_max_segment_size: int
    exit_on_done: bool

    def __init__(self, startup_config_files: list[str], db_spec: ?str,
                 http_port: int, netconf_port: int,
                 netconf_host_key_path: ?str,
                 netconf_user: str, netconf_password: str,
                 udp_notif_listen_address: str,
                 udp_notif_receiver_address: ?str,
                 udp_notif_source_interface: ?str,
                 udp_notif_max_segment_size: int,
                 exit_on_done: bool):
        self.startup_config_files = startup_config_files
        self.db_spec = db_spec
        self.http_port = http_port
        self.netconf_port = netconf_port
        self.netconf_host_key_path = netconf_host_key_path
        self.netconf_user = netconf_user
        self.netconf_password = netconf_password
        self.udp_notif_listen_address = udp_notif_listen_address
        self.udp_notif_receiver_address = udp_notif_receiver_address
        self.udp_notif_source_interface = udp_notif_source_interface
        self.udp_notif_max_segment_size = udp_notif_max_segment_size
        self.exit_on_done = exit_on_done

    @staticmethod
    def parser() -> argconf.Parser:
        """Return the system settings schema."""
        p = argconf.Parser("STRATOWEAVE", "[FILE ...]")
        p.add_str(
            "db", default="",
            help="TTT database: an LMDB path or a database URL"
        )
        p.add_int("http_port", default=80, help="HTTP listen port")
        p.add_int("netconf_port", default=830, help="NETCONF SSH listen port")
        p.add_str(
            "netconf_host_key", default="",
            help="SSH host key file for NETCONF; ephemeral in-memory key if unset"
        )
        p.add_str(
            "netconf_user", default="admin",
            help="NETCONF SSH username (v1 static credential)"
        )
        p.add_str(
            "netconf_password", default="admin",
            help="NETCONF SSH password (v1 static credential)"
        )
        p.add_str(
            "udp_notif_listen_address", default="0.0.0.0",
            help="Local address for IOS XR UDP-Notif listeners"
        )
        p.add_str(
            "udp_notif_receiver_address", default="",
            help="Address IOS XR devices use to reach this StratoWeave instance; enables UDP-Notif"
        )
        p.add_str(
            "udp_notif_source_interface", default="",
            help="Optional IOS XR source interface for UDP-Notif traffic"
        )
        p.add_int(
            "udp_notif_max_segment_size", default=1232,
            help="Maximum IOS XR UDP-Notif datagram segment size"
        )
        p.add_bool("exit_on_done", help="Exit after startup config has been applied")
        return p

    @staticmethod
    def parse(argv: list[str],
              system_settings: ?list[dict[str, ?value]]=None,
              environment: ?dict[str, str]=None) -> SystemSettings:
        """Resolve system settings without reading process state or files."""
        args = SystemSettings.parser().parse(argv, system_settings, environment)
        db_spec = args.get_str("db")
        host_key = args.get_str("netconf_host_key")
        receiver_address = args.get_str("udp_notif_receiver_address")
        source_interface = args.get_str("udp_notif_source_interface")
        return SystemSettings(
            args.rest,
            db_spec if db_spec != "" else None,
            args.get_int("http_port"),
            args.get_int("netconf_port"),
            host_key if host_key != "" else None,
            args.get_str("netconf_user"),
            args.get_str("netconf_password"),
            args.get_str("udp_notif_listen_address"),
            receiver_address if receiver_address != "" else None,
            source_interface if source_interface != "" else None,
            args.get_int("udp_notif_max_segment_size"),
            args.get_bool("exit_on_done"))


NS_SW_RFS = "http://stratoweave.org/yang/stratoweave-rfs"


def _rfs_for_device(dev):
    def q(n):
        return ygdata.Id(NS_SW_RFS, n)

    return ygdata.Container({
        q('rfs'): ygdata.List([q("name")], [
            ygdata.Container({
                q("name"): ygdata.Leaf(dev)
            })
        ])
    })


actor RfsReconf(dev_registry: swdev.DeviceRegistry, cfs: ttt.Layer):
    _rfs = cfs
    while True:
        _next = _rfs.below()
        # RFS is 2nd to last layer
        if _next.below() is _next:
            break
        _rfs = _next

    dev_registry.on_reconf(lambda dev: _rfs.edit_config(_rfs_for_device(dev)))


actor StartupConfigApplier(startup_config_files: list[str], exit_on_done: bool, top_schema: yschema.DRoot, cfs: ttt.Layer, exit: action(int) -> None, rfcap: file.ReadFileCap, log_handler: logging.Handler):
    var log = logging.Logger(log_handler)

    def _conf_load_done(result):
        if isinstance(result, Exception):
            log.error("Error applying config file(s)", {"error": result})
            exit(1)
        else:
            log.info("All config files applied")
            if exit_on_done:
                log.info("No more config files to apply, exiting..")
                exit(0)

    def _apply():
        # Read and apply config files; merge multiple snippets (files) into a single intent
        input_merge = ygdata.Container()
        for filename in startup_config_files:
            log.debug("Reading config file", {"config_file": filename})
            f = file.ReadFile(rfcap, filename)
            data = f.read()
            f.close()
            try:
                conf_xml = xml.decode(data.decode())
                conf_gd = yxml.from_xml(top_schema, conf_xml, loose=True)
                input_merge = ygdata.merge(input_merge, conf_gd)
            except Exception as e:
                print("Error reading config file {filename}: {e}")
                exit(1)
                return

        log.info("Applying config file(s)...")
        session = cfs.newsession()
        session.edit_config(input_merge, None, _conf_load_done)

    if len(startup_config_files) > 0:
        after 0.5: _apply()


actor StartupBootstrap(cfs: ttt.Layer, restore_from_db: bool, netconf_host_key_path: ?str, rfcap: file.ReadFileCap, start_runtime: proc(?str) -> None, exit: action(int) -> None, log_handler: logging.Handler):
    var log = logging.Logger(log_handler)
    var _netconf_host_key: ?str = None

    def _recompute_done(result):
        if isinstance(result, Exception):
            log.error("Error recomputing restored TTT state", {"error": result})
            exit(1)
            return
        log.info("Restored TTT state reconciled")
        start_runtime(_netconf_host_key)

    def _restore_done(error: ?Exception) -> None:
        if error is not None:
            log.error("Error loading persisted TTT state", {"error": error})
            exit(1)
            return
        log.info("Recomputing restored TTT state")
        cfs.newsession().recompute(_recompute_done)

    def _run():
        # The NETCONF SSH layer wants host-key material, not a path, so read the
        # configured key file here (before launching the runtime) and forward it.
        hkp = netconf_host_key_path
        if hkp is not None:
            try:
                f = file.ReadFile(rfcap, hkp)
                _netconf_host_key = f.read().decode()
                f.close()
            except Exception as e:
                log.error("Error reading NETCONF host key", {"path": hkp, "error": e})
                exit(1)
                return

        if not restore_from_db:
            start_runtime(_netconf_host_key)
            return

        log.info("Loading persisted TTT state")
        cfs.load_from_db(_restore_done)

    after 0: _run()
