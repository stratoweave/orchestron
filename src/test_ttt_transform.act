actor empty_lock(t: testing.AsyncT):
    router = ttt.Transform(ttt.PassThrough) (ttt.PathRoot("0:"), None)
    t1 = router.newtrans()
    t2 = router.newtrans()

    t2.configure("2", {'srcB': y3}, None)

    def cont1(_r: value):
        t1.commit("1", True)
        t2.lock("2", None, cont2)

    def cont2(_r: value):
        t2.configure("2", {'srcB': y2}, None)
        t2.commit("2", True)
        r = t2.get()
        testing.assertEqual(r, y2)
        t.success()

    t1.lock("1", None, cont1)

