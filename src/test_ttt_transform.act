a0 = gdata.Container({
    q('a'): gdata.Leaf(0)
})

a1 = gdata.Container({
    q('a'): gdata.Leaf(1)
})

b1 = gdata.Container({
    q('b'): gdata.Leaf(1)
})

a0b1 = gdata.Container({
    q('a'): gdata.Leaf(0),
    q('b'): gdata.Leaf(1)
})

actor config_failure(t: testing.AsyncT):
    router = ttt.Transform(ttt.PassThrough) (ttt.PathRoot("0:"), None)
    t1 = router.newtrans()
    t2 = router.newtrans()

    t1.configure("1", {'srcA': a0}, None)
    t2.configure("2", {'srcB': a1}, None)

    def cont1(_r: ttt.CfgResult):
        t1.commit("1", True)

        def cont2(_r: ttt.CfgResult):
            if _r.errors:
                t2.configure("2", {'srcB': b1}, None)
            t2.commit("2", True)
            r = t2.get()
            testing.assertEqual(r, a0b1)
            t.success()

        t2.lock("2", None, cont2)

    t1.lock("1", None, cont1)

########################

actor config_abort(t: testing.AsyncT):
    router = ttt.Transform(ttt.PassThrough) (ttt.PathRoot("0:"), None)
    t1 = router.newtrans()
    t2 = router.newtrans()

    t1.configure("1", {'srcA': a0}, None)
    t2.configure("2", {'srcB': a1}, None)

    def cont1(_r: value):
        t1.commit("1", False)
        t2.lock("2", None, cont2)

    def cont2(_r: value):
        t2.commit("2", True)
        r = t2.get()
        testing.assertEqual(r, a1)
        t.success()

    t1.lock("1", None, cont1)

