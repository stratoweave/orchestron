actor empty_lock2(t: testing.AsyncT):
    router = ttt.Transform(ttt.PassThrough) (ttt.PathRoot("0:"), None)
    t1 = router.newtrans()
    t2 = router.newtrans()

    t2.configure("2", {'srcB': y3}, None)

    def cont1(_r: value):
        t1.commit("1", True)
        r2 = t2.get()
        testing.assertEqual(r2, y2)
        r1 = t1.get()
        testing.assertEqual(r1, y2)
        t.success()

    def cont2(_r: value):
        t2.configure("2", {'srcB': y2}, None)
        t2.commit("2", True)
        t1.lock("1", None, cont1)

    t2.lock("2", None, cont2)

