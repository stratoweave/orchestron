actor no_lock(t: testing.AsyncT):
    router = ttt.Transform(ttt.PassThrough) (ttt.PathRoot("0:"), None)
    t1 = router.newtrans()
    t2 = router.newtrans()

    t1.configure("1", {'srcA': y1}, None)
    t2.configure("2", {'srcB': y3}, None)

    def cont2(_r: value):
        t1.commit("1", True)
        t2.configure("2", {'srcB': y2}, None)
        t2.commit("2", True)
        r = t2.get()
        testing.assertEqual(r, y2)
        t.success()

    t2.lock("2", None, cont2)

