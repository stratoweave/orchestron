class MemoryTransform(ttt.TransformFunction):
    def transform_wrapper(self, cfg: gdata.Node, linked: gdata.Node, memory: ?gdata.Node, dynstate: ?gdata.Node):
        if memory is not None and isinstance(memory, gdata.Leaf):
            _memory: gdata.Leaf = memory
            val = _memory.val
            if isinstance(val, int) and val == 42:
                return (cfg, memory)
        elif isinstance(cfg, gdata.Leaf):
            _cfg: gdata.Leaf = cfg
            val = _cfg.val
            if isinstance(val, int) and val == 42:
                new_memory = gdata.Leaf(42)
                return (cfg, new_memory)

        # testing.error()
        raise AssertionError("Test error")

actor transform_memory(t: testing.AsyncT):
    router = ttt.Transform(MemoryTransform) (ttt.PathRoot("0:"), None)

    s1 = ttt.Session("s1", router, None)

    def cont2(_r: value):
        t.success()

    def cont1(_r: value):
        s2 = ttt.Session("s2", router, None)
        s2.edit_config(gdata.Leaf(0), None, cont2)

    s1.edit_config(gdata.Leaf(42), None, cont1)

########################

class FailingTransform(ttt.TransformFunction):
    def transform_wrapper(self, cfg: gdata.Node, linked: gdata.Node, memory: ?gdata.Node, dynstate: ?gdata.Node):
        raise AssertionError("Test transform error")

actor transform_exception(t: testing.AsyncT):
    router = ttt.Transform(FailingTransform) (ttt.PathRoot("0:"), None)
    sess = ttt.Session("s1", router, None)

    def cont(res):
        testing.assertEqual(isinstance(res, Exception), True)
        testing.assertEqual(sess.get(), gdata.Container())
        t.success()

    sess.edit_config(gdata.Leaf(1), cont)

