#
# IOS XE software adapter.
#
# IOS XE workflow:
#
#   prepare  = xcopy the image onto bootflash                non-impacting
#   install  = install (add), then activate with an
#              auto-abort timer; the device reloads          impacting
#   commit   = install-commit, stops the timer
#   rollback = abort; the device reloads on the old release  impacting
#
# Without a commit the device reverts on its own when the timer runs out.
#
# Cleanup and retry are not implemented. Cleanup leaves the previous image on
# the device.
#
# Install RPCs are asynchronous. An <ok/> reply means accepted, not complete.
# The adapter polls operational state for completion.
#
# See src/adapters/test_software_iosxe.act for the device side, mocked.
#

import logging
import net
import time

import yang.gdata as ygdata

import device as swdev
import adapters.software_iosxe_oper as ixoper
import adapters.software_iosxe_rpc as ixrpc

from device_meta_config import stratoweave_rfs__device_entry as DeviceMetaConfig

# install-oper op-status. MARKED_SUCC means the device had nothing to do, which
# is not confirmation that what we asked for happened -- but it is not a failure
# either. FAIL_REVERT means the device is undoing the operation.
OP_SUCC = "install-op-succ"
OP_MARKED_SUCC = "install-op-marked-succ"
OP_FAIL_REVERT = "install-op-fail-revert"
# install-oper op-done.
OP_COMPLETE = "op-complete"
OP_REVERTED = "op-reverted"

# The stage that ends each records-polled job. A pure file copy really does
# report through the install records.
STAGE_DOWNLOAD = "install-txn-download"
STAGE_ADD_END = "install-txn-add-postchk"

POLL_PERIOD = 10.0
RELOAD_POLL_PERIOD = 20.0
# Generous: the transfer and the add each take minutes.
MAX_POLLS = 180

# Minutes the device waits for install-commit after activation before it
# reverts. 30 is the smallest value it accepts.
AUTO_ABORT_TIMER_MIN = 30
# Reload polls stop a little past the abort timer: by then the device has
# reverted and the release we wait for cannot appear. Roughly (30 + 5) minutes
# over the 20 s reload poll period.
VERSION_MAX_POLLS = (AUTO_ABORT_TIMER_MIN + 5) * 3

# Wall-clock estimates in seconds, measured on a c8000v with a 962 MB image.
ESTIMATE_TRANSFER = 150
ESTIMATE_INSTALL = 390


#############################################################################
# Pure: version handling
#
# The device spells one release three ways -- the operator writes 17.18.03a, the
# banner says 17.18.3a, the inventory says 17.18.03a.0.5540 -- so none of this
# can be a string compare.
#############################################################################

DIGITS = "0123456789"


def _split_component(c: str) -> (num: ?int, suffix: str):
    """Split a version component into its leading number and any suffix, so
    "03a" becomes (3, "a")."""
    digits = ""
    i = 0
    while i < len(c) and c[i] in DIGITS:
        digits += c[i]
        i += 1
    num = None
    if len(digits) > 0:
        num = int(digits)
    return (num=num, suffix=c[i:])


def _component_eq(a: str, b: str) -> bool:
    sa = _split_component(a)
    sb = _split_component(b)
    an = sa.num
    bn = sb.num
    if an is not None and bn is not None:
        return an == bn and sa.suffix == sb.suffix
    return a == b


def releases_equal(a: ?str, b: ?str) -> bool:
    """Compare two release names per component, not as strings.

    The device reports 17.18.3a where the image file says 17.18.03a, so a string
    comparison declares a successful upgrade a failure.
    """
    if a is None:
        return False
    if b is None:
        return False
    ap = a!.split(".")
    bp = b!.split(".")
    if len(ap) != len(bp):
        return False
    i = 0
    while i < len(ap):
        if not _component_eq(ap[i], bp[i]):
            return False
        i += 1
    return True


def release_from_filename(filename: str) -> ?str:
    """The release an image file is named for, or None.

    The mock reports whatever image it installed, and a campaign may target any
    catalogue release, so the release has to come out of the file name:
    c8000v-universalk9.17.18.03a.SPA.bin gives 17.18.03a. It is the run of
    dot-separated components that start with a digit, whatever the platform
    prefix and the suffix are; fewer than two such components is no release.
    """
    run: list[str] = []
    for part in filename.split("."):
        if len(part) > 0 and part[0] in DIGITS:
            run.append(part)
        elif len(run) > 0:
            break
    if len(run) < 2:
        return None
    return ".".join(run)


def reported_release(release: str) -> str:
    """How the device banner spells a release: leading zeros dropped from each
    component, so 17.18.03a becomes 17.18.3a. Equal to the input under
    releases_equal."""
    out: list[str] = []
    for c in release.split("."):
        s = _split_component(c)
        n = s.num
        if n is not None:
            out.append(str(n!) + s.suffix)
        else:
            out.append(c)
    return ".".join(out)


def running_release(root: ?ygdata.Node) -> ?str:
    """The release the device reports running, from device-hardware-oper.

    The leaf carries a whole banner line, so pull the version out of it.
    """
    oper = ixoper.root.from_gdata(root)
    hardware = oper.device_hardware_data.device_hardware
    text = hardware.device_system_data.software_version
    if text is None:
        return None
    # "Cisco IOS XE Software, Version 17.18.02" -> "17.18.02"
    marker = "Version "
    body = text!
    idx = body.find(marker)
    if idx < 0:
        return body
    rest = body[idx + len(marker):]
    end = rest.find(",")
    if end >= 0:
        rest = rest[:end]
    return rest.strip()


#############################################################################
# Pure: operation records
#############################################################################

def records_for(root: ?ygdata.Node, uuid: str) -> list[(status: str,
                                                        done: str,
                                                        stages: list[str])]:
    """Every record carrying this uuid, live and historical.

    Both lists, because a record moves from install-oper to install-oper-hist
    when it finishes and the move can happen between two polls.
    """
    out: list[(status: str, done: str, stages: list[str])] = []
    iod = ixoper.root.from_gdata(root).install_oper_data
    for e in iod.install_oper:
        if e.op_uuid != uuid:
            continue
        stages: list[str] = []
        for t in e.install_txn_summary_op:
            cmd = t.txn_cmd
            if cmd is not None:
                stages.append(cmd!)
        status = e.op_status
        done = e.op_done
        out.append((status=status! if status is not None else "",
                    done=done! if done is not None else "",
                    stages=stages))
    for e in iod.install_oper_hist:
        if e.op_uuid != uuid:
            continue
        stages = []
        for t in e.install_txn_sum_op_hist:
            cmd = t.txn_cmd
            if cmd is not None:
                stages.append(cmd!)
        status = e.op_status
        done = e.op_done
        out.append((status=status! if status is not None else "",
                    done=done! if done is not None else "",
                    stages=stages))
    return out


def aggregate(root: ?ygdata.Node, uuid: str, expect_stage: str,
              allow_noop: bool=True) -> (done: bool, failed: bool, detail: str):
    """Return completion and failure state for an operation UUID.

    Completion requires terminal records and the expected final stage. A later
    record may not have appeared yet even when all current records succeeded.
    An empty `expect_stage` skips that wait, for operations with one record.
    With `allow_noop` False, `install-op-marked-succ` is a failure: the device
    found nothing to do.
    """
    recs = records_for(root, uuid)
    if len(recs) == 0:
        return (done=False, failed=False, detail="no records yet")
    saw_end = False
    for r in recs:
        if r.done == OP_REVERTED or r.status == OP_FAIL_REVERT:
            return (done=True, failed=True, detail="operation reverted: {r.status}")
        finished = r.done == OP_COMPLETE
        if finished and r.status == OP_MARKED_SUCC and not allow_noop:
            return (done=True, failed=True, detail="nothing to do: {r.status}")
        if finished and r.status != OP_SUCC and r.status != OP_MARKED_SUCC:
            return (done=True, failed=True, detail="stage failed: {r.status}")
        if not finished:
            return (done=False, failed=False, detail="still running")
        for s in r.stages:
            if s == expect_stage:
                saw_end = True
    if expect_stage != "" and not saw_end:
        return (done=False, failed=False, detail="waiting for {expect_stage}")
    return (done=True, failed=False, detail="")


#############################################################################
# Pure: filters and RPC bodies
#############################################################################

def version_filter() -> ygdata.FNode:
    """Select the running software version."""
    paths = ixoper.subs.device_hardware_data.device_hardware.device_system_data
    return paths.software_version.filt()!


def records_filter() -> ygdata.FNode:
    """Select the active and finished operation lists.

    Selecting complete lists avoids `ygdata.filter`'s keyless-list bug while
    excluding large siblings such as `install-packages`.
    """
    # TODO: Select only the required leaves after acton-yang preserves every
    # keyless-list entry and an empty selected list no longer drops matching
    # sibling data.
    paths = ixoper.subs.install_oper_data
    return paths.subscribe(select=[paths.install_oper,
                                   paths.install_oper_hist]).filt!


def versions_filter() -> ygdata.FNode:
    """Select the per-location version state, which names the added image.

    Selecting the whole location list, like `records_filter`, keeps every
    keyless entry and drops the large install-packages sibling.
    """
    paths = ixoper.subs.install_oper_data
    return paths.subscribe(select=[paths.install_location_information]).filt!


def added_version(root: ?ygdata.Node, release: str) -> ?str:
    """The device's version string for an added image of `release`.

    The device names an added image like 17.18.03a.0.5540, which `activate`
    needs; the running image is there too, so match on the release the version
    starts with rather than on the state, which changes through the add.
    """
    iod = ixoper.root.from_gdata(root).install_oper_data
    for loc in iod.install_location_information:
        for v in loc.install_version_state_info:
            ver = v.version
            if ver is not None:
                parts = ver.split(".")
                if len(parts) >= 3 and releases_equal(".".join(parts[:3]), release):
                    return ver
    return None


def image_filename(url: str) -> str:
    """The filename an image URL will land under on bootflash.

    The last path component, which is right for every scheme the device
    supports: an scp source is scp://user:password@host:/path/to/file, so the
    credentials and the colon before the path fall to the left of the last
    slash.
    """
    parts = url.split("/")
    return parts[len(parts) - 1]


def redact_url(url: str) -> str:
    """A URL with any embedded credentials removed, for logging.

    scp and ftp sources carry them in the URL itself, so it cannot be logged as
    given. Everything between the scheme and the last `@` goes, which covers a
    password containing `@` or `:` as well.
    """
    marker = "://"
    at = url.rfind("@")
    scheme_end = url.find(marker)
    if at < 0 or scheme_end < 0 or at < scheme_end:
        return url
    return url[:scheme_end + len(marker)] + "***@" + url[at + 1:]


def job_uuid(phase: str, release: str, token: str) -> str:
    """The uuid one operation runs under.

    The token is what keeps two attempts apart. The device keeps finished
    operations in install-oper-hist and we find our records by uuid, so a uuid
    that is only a function of the release makes a second attempt match the
    first attempt's failure and give up before the device has begun.
    """
    return "swi-{phase}-{release}-{token}"


def xcopy_input(uuid: str, url: str, filename: str) -> ixrpc.Cisco_IOS_XE_xcopy_rpc__xcopy__input:
    """Stage an image. `destination_path` must be a bare filename: the device
    prepends /bootflash itself, so passing a path doubles it and fails."""
    return ixrpc.Cisco_IOS_XE_xcopy_rpc__xcopy__input(
        uuid=uuid, source_path=url, destination_path=filename)


def install_input(uuid: str, filename: str) -> ixrpc.Cisco_IOS_XE_install_rpc__install__input:
    """Add the staged file without activating it.

    `path` needs the `bootflash:` prefix, the opposite convention to xcopy's
    destination.
    """
    return ixrpc.Cisco_IOS_XE_install_rpc__install__input(
        uuid=uuid, one_shot=False, path="bootflash:" + filename)


def activate_input(uuid: str, version: str,
                   timer_min: int) -> ixrpc.Cisco_IOS_XE_install_rpc__activate__input:
    """Boot an added image by version. The device reverts unless install-commit
    arrives within `timer_min` minutes."""
    return ixrpc.Cisco_IOS_XE_install_rpc__activate__input(
        uuid=uuid, auto_abort_timer_val=u64(timer_min), version=version)


def commit_input(uuid: str) -> ixrpc.Cisco_IOS_XE_install_rpc__install_commit__input:
    return ixrpc.Cisco_IOS_XE_install_rpc__install_commit__input(uuid=uuid)


def abort_input(uuid: str) -> ixrpc.Cisco_IOS_XE_install_rpc__abort__input:
    return ixrpc.Cisco_IOS_XE_install_rpc__abort__input(uuid=uuid)


#############################################################################
# The adapter
#############################################################################

actor IosXeSoftwareDriver(dev: swdev.DeviceMgr, log_handler: logging.Handler,
                          poll_period: float=POLL_PERIOD,
                          reload_poll_period: float=RELOAD_POLL_PERIOD):
    """Serializes IOS XE software jobs and owns their polling state.

    One job at a time. Install is two phases: add, then activate the added
    image by the version the device assigned it. Record phases poll
    install-oper-data until the expected stage completes; version phases poll
    the running release until it reaches the target.
    """
    _log = logging.Logger(log_handler)
    # The adapter is built inside DeviceMgr.set_dmc. Calling dev.tree_provider()
    # synchronously here would call back into the same actor and deadlock.
    _rpcs = ixrpc.rpc_root(swdev.DeviceTreeProvider(dev))

    var _phase = ""          # stage | add | activate | commit | abort
    var _gen = 0
    var _polls = 0
    var _release = ""
    var _uuid = ""
    var _filename = ""
    var _expect_stage = ""
    var _allow_noop = True
    # Release a version phase waits for. None while aborting with the previous
    # release unknown: then any release but the aborted one will do.
    var _want: ?str = None
    var _done: ?action(?Exception) -> None = None
    # Activate has run and the device is reloading, so poll the release now
    # instead of the operation record.
    var _activate_booting = False
    # Monotonic seconds when activate was sent; the device timer runs from there.
    var _activated_at: ?int = None

    def _finish(err: ?Exception) -> None:
        d = _done
        _phase = ""
        _done = None
        _activate_booting = False
        _gen += 1
        if d is not None:
            d!(err)

    def _busy() -> bool:
        return _phase != ""

    def _new_token() -> str:
        """A timestamp token with microsecond resolution."""
        secs, nanos = time.get_realtime()
        return "{secs}-{nanos // 1000}"

    def _image_url() -> ?str:
        """Read the image URL at job start so configuration changes take effect."""
        url = dev.get_dmc().software.image_url
        if url is None or url! == "":
            return None
        return url

    def _start(phase: str, done: action(?Exception) -> None, release: str) -> bool:
        """Claim the driver for a job. False, after reporting, if one is running."""
        if _busy():
            done(ValueError("software job already running: {_phase}"))
            return False
        _done = done
        _release = release
        _enter(phase)
        return True

    def _enter(phase: str) -> None:
        """Begin a phase under a fresh uuid. Bumping _gen drops the previous
        phase's pending polls."""
        _gen += 1
        _phase = phase
        _uuid = job_uuid(phase, _release, _new_token())
        _polls = 0
        _expect_stage = ""
        _allow_noop = True
        _want = None
        _activate_booting = False

    def _on_rpc(gen: int, period: float) -> action(?Exception) -> None:
        """Reply handler for an input-only RPC: start polling once accepted."""
        def cb(err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _finish(err)
                return
            after period: _poll(gen)
        return cb

    ####################################################################
    # check
    ####################################################################

    def check(done: action(?str, ?Exception) -> None) -> None:
        def on_reply(root: ?ygdata.Node, err: ?Exception) -> None:
            if err is not None:
                done(None, err)
                return
            done(running_release(root), None)
        dev.get(on_reply, version_filter())

    ####################################################################
    # prepare: stage the image, touching no install state
    ####################################################################

    def prepare(done: action(?Exception) -> None, release: str) -> None:
        if not _start("stage", done, release):
            return
        url = _image_url()
        if url is None:
            _finish(ValueError("no image-url configured for release {release}"))
            return
        _filename = image_filename(url!)
        _expect_stage = STAGE_DOWNLOAD
        gen = _gen
        _log.info("software: staging image",
                  {"url": redact_url(url!), "uuid": _uuid})
        def on_rpc(out: ?ixrpc.Cisco_IOS_XE_xcopy_rpc__xcopy__output,
                   err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _finish(err)
                return
            after poll_period: _poll(gen)
        _rpcs.xcopy(on_rpc, xcopy_input(_uuid, url!, _filename))

    ####################################################################
    # install: add, then activate the added image; device reloads
    ####################################################################

    def install(done: action(?Exception) -> None, release: str) -> None:
        # TODO: Verify the image is still staged and repeat prepare if needed.
        if not _start("add", done, release):
            return
        url = _image_url()
        if url is None:
            _finish(ValueError("no image-url configured for release {release}"))
            return
        _filename = image_filename(url!)
        _expect_stage = STAGE_ADD_END
        _activated_at = None
        _log.info("software: adding image", {"file": _filename, "uuid": _uuid})
        _rpcs.install(_on_rpc(_gen, poll_period), install_input(_uuid, _filename))

    def _after_add() -> None:
        # An added image is activated by the version the device assigned it,
        # not by its bootflash path, so read the version state first.
        gen = _gen
        def on_versions(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _finish(err)
                return
            ver = added_version(root, _release)
            if ver is None:
                _finish(ValueError("added image for {_release} not found"))
                return
            _activate(ver!)
        dev.get(on_versions, versions_filter())

    def _activate(version: str) -> None:
        _enter("activate")
        _want = _release
        secs, nanos = time.get_monotonic()
        _activated_at = secs
        _log.info("software: activating, device will reload",
                  {"version": version, "uuid": _uuid})
        _rpcs.activate(_on_rpc(_gen, poll_period),
                       activate_input(_uuid, version, AUTO_ABORT_TIMER_MIN))

    ####################################################################
    # commit: keep the activated release, stop the abort timer
    ####################################################################

    def commit(done: action(?Exception) -> None) -> None:
        if not _start("commit", done, _release):
            return
        # One record and no reload, so completion alone ends the job. A no-op
        # means nothing was uncommitted: the device had already reverted.
        _allow_noop = False
        _log.info("software: committing", {"release": _release, "uuid": _uuid})
        _rpcs.install_commit(_on_rpc(_gen, poll_period), commit_input(_uuid))

    def commit_window(done: action(?int) -> None) -> None:
        a = _activated_at
        if a is None:
            done(None)
            return
        secs, nanos = time.get_monotonic()
        done(AUTO_ABORT_TIMER_MIN * 60 - (secs - a!))

    ####################################################################
    # rollback: abort the uncommitted release; device reloads
    ####################################################################

    def rollback(done: action(?Exception) -> None, previous: ?str) -> None:
        if not _start("abort", done, _release):
            return
        _want = previous
        _log.info("software: aborting, device will reload",
                  {"previous": str(previous), "uuid": _uuid})
        _rpcs.abort(_on_rpc(_gen, reload_poll_period), abort_input(_uuid))

    ####################################################################
    # polling -- the only completion signal an accepted RPC gives
    ####################################################################

    def _poll(gen: int) -> None:
        if gen != _gen or not _busy():
            return
        _polls += 1
        limit = VERSION_MAX_POLLS if (_phase == "activate" or _phase == "abort") else MAX_POLLS
        if _polls > limit:
            _finish(ValueError("software job {_phase} did not finish in time"))
            return
        if _phase == "abort":
            _poll_version(gen)
        elif _phase == "activate":
            if _activate_booting:
                _poll_version(gen)
            else:
                _poll_activate(gen)
        else:
            _poll_records(gen)

    def _poll_activate(gen: int) -> None:
        # Watch the activate operation until it fails its prechecks or the
        # session drops as the device reloads. A read error is the reload, not
        # a failure, so switch to waiting for the release.
        after poll_period: _poll(gen)
        def on_oper(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _activate_booting = True
                return
            v = aggregate(root, _uuid, "", True)
            if not v.done:
                return
            if v.failed:
                _finish(ValueError("activate failed: {v.detail}"))
                return
            _activate_booting = True
        dev.get(on_oper, records_filter())

    def _poll_records(gen: int) -> None:
        # Schedule the next poll before starting the read so a missing callback
        # does not stop polling.
        after poll_period: _poll(gen)
        def on_oper(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                return
            v = aggregate(root, _uuid, _expect_stage, _allow_noop)
            if not v.done:
                return
            if v.failed:
                _finish(ValueError("{_phase} failed: {v.detail}"))
                return
            _log.info("software: {_phase} done", {"uuid": _uuid})
            _end_phase()
        dev.get(on_oper, records_filter())

    def _end_phase() -> None:
        if _phase == "add":
            _after_add()
        else:
            _finish(None)

    def _reached(got: str) -> bool:
        w = _want
        if w is not None:
            return releases_equal(got, w)
        return not releases_equal(got, _release)

    def _poll_version(gen: int) -> None:
        after reload_poll_period: _poll(gen)
        def on_version(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                # The device is reloading. Not a failure.
                return
            got = running_release(root)
            if got is None:
                return
            if _reached(got!):
                _log.info("software: device booted", {"release": got!})
                _end_phase()
        dev.get(on_version, version_filter())

    ####################################################################
    # not implemented -- continues without acting
    ####################################################################

    def cleanup(done: action(?Exception) -> None) -> None:
        # Keep the previous image for manual recovery.
        _log.info("software: cleanup is not implemented, continuing")
        done(None)


class IosXeSoftwareAdapter(swdev.SoftwareAdapter):
    """Software adapter for IOS XE. See the module header for the scope."""

    _driver: IosXeSoftwareDriver

    def __init__(self, dev: swdev.DeviceMgr, dmc: DeviceMetaConfig,
                 log_handler: logging.Handler, connect_cap: ?net.TCPConnectCap,
                 poll_period: float=POLL_PERIOD,
                 reload_poll_period: float=RELOAD_POLL_PERIOD):
        # The poll periods are parameters only so a test can drive them fast.
        # A device type names a small factory that calls this with defaults;
        # `_fast_adapter` in adapters.test_software_iosxe is the pattern.
        self._log_handler = log_handler
        self._driver = IosXeSoftwareDriver(dev, log_handler, poll_period,
                                          reload_poll_period)

    def supports_mocking(self) -> bool:
        return True

    def check(self, done: action(?str, ?Exception) -> None) -> None:
        self._driver.check(done)

    def matches_release(self, running: ?str, target: str) -> bool:
        return releases_equal(running, target)

    def prepare(self, done: action(?Exception) -> None, release: str) -> None:
        self._driver.prepare(done, release)

    def install(self, done: action(?Exception) -> None, release: str) -> None:
        self._driver.install(done, release)

    def rollback(self, done: action(?Exception) -> None, previous: ?str) -> None:
        self._driver.rollback(done, previous)

    def commit(self, done: action(?Exception) -> None) -> None:
        self._driver.commit(done)

    def commit_window(self, done: action(?int) -> None) -> None:
        self._driver.commit_window(done)

    def cleanup(self, done: action(?Exception) -> None) -> None:
        self._driver.cleanup(done)

    def estimate(self, staged: bool) -> int:
        if staged:
            return ESTIMATE_INSTALL
        return ESTIMATE_TRANSFER + ESTIMATE_INSTALL
