actor persist_transform_state_snapshot(t: testing.EnvT):
    fc = file.FileCap(t.env.cap)
    fs = file.FS(fc)
    db_path = fs.mktmpdir("test_ttt_persist_stateful_")
    cap = file.WriteFileCap(fc)
    db = swlmdb.LmdbStore(cap, db_path)
    var root: ?ttt.Node = None
    flow = StatefulTransformWriteFlow(t, fs, db_path, db)

    def rootgen(path, lower):
        root = ttt.Transform(PersistDynstateTransform)(path, lower)
        return root!

    def after_recompute(r: value) -> None:
        if not (isinstance(r, str) and r == "Ok"):
            raise AssertionError("Expected successful dynstate recompute for snapshot, got {r}")
        flow.after_settled()

    def after_initial_commit(r: value) -> None:
        if not isinstance(r, str):
            raise AssertionError("Expected successful initial stateful completion, got {r}")
        root1 = root!
        root1.newtrans().restore(swdb.ATTR_DYNSTATE, None, gdata.Leaf(41).to_json_str(pretty=False).encode())
        ttt.Session("persist_stateful", root1, None, db).recompute(after_recompute)

    layer: ttt.Layer = ttt.Layer("stateful", rootgen, None, db)
    layer.edit_config(stateful_cfg, None, after_initial_commit)


actor restore_transform_round_trip(t: testing.EnvT):
    fc = file.FileCap(t.env.cap)
    fs = file.FS(fc)
    db_path = fs.mktmpdir("test_ttt_restore_transform_")
    cap = file.WriteFileCap(fc)
    var db = swlmdb.LmdbStore(cap, db_path)
    var restored = ttt.Layer("single", ttt.Transform(ttt.PassThrough), None, db)

    def after_recommit(_r: value) -> None:
        testing.assertEqual(restored.get(), persist_cfg_updated)
        await async db.db.close()
        await async fs.rmtree(db_path)
        await async fs.rmdir(db_path)
        t.success()

    def after_restore(error: ?Exception) -> None:
        if error is not None:
            raise error
        testing.assertEqual(restored.get(), persist_cfg)
        restored.edit_config(persist_cfg_updated, None, after_recommit)

    def after_initial_commit(_r: value) -> None:
        await async db.db.close()
        db = swlmdb.LmdbStore(cap, db_path)
