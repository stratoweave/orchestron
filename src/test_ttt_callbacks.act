import testing
import logging

import ttt as ttt
import yang.gdata as gdata
import yang.adata as yadata
import device as swdev
from device_meta_config import \
    stratoweave_rfs__device_entry as DeviceMetaConfig, \
    stratoweave_rfs__device__credentials as Credentials, \
    stratoweave_rfs__device__mock as Mock, \
    stratoweave_rfs__device__mock__module_entry as MockModule

TEST_NS = "urn:test"

def q(n: str) -> gdata.Id:
    return gdata.Id(TEST_NS, n)

def mock_with_module() -> Mock:
    return Mock(module=[MockModule(name="mock-module", namespace="urn:mock", revision=None)])

########################

actor reconf(t: testing.AsyncT):
    dev_registry = swdev.DeviceRegistry(log_handler=t.log_handler)

    def reconf_cb(dev):
        #print("Reconfiguring", dev)
        t.success()
        
    dmc = DeviceMetaConfig("k1", Credentials("admin", "admin"), mock=mock_with_module())
    dev_registry.on_reconf(reconf_cb)
    dev_registry.get_or_create("k1").set_dmc(dmc)


########################

cfg2 = gdata.List([q("name")], [
    gdata.Container({
        q("name"): gdata.Leaf("k1"),
        q("config"): gdata.Container({
            q("val"): gdata.Leaf("one")
        })
    }),
    gdata.Container({
        q("name"): gdata.Leaf("k2"),
        q("config"): gdata.Container({
            q("val"): gdata.Leaf("two")
        })
    })
])

actor reconf2(t: testing.AsyncT):
    dev_registry = swdev.DeviceRegistry(log_handler=t.log_handler)
    stack = ttt.Layer("devices", ttt.List(ttt.DeviceConfig(dev_registry), [q("name")]), None)
    
    var devs = set()
    
    def reconf_cb(dev):
        devs.add(dev)
        #print("Reconfiguring", dev)
        if devs == {"k1", "k2"}:
            t.success()
        
    dev_registry.on_reconf(reconf_cb)
    sess = stack.newsession()
    
    def cont1(_r):
        dmc = DeviceMetaConfig("k1", Credentials("admin", "admin"), mock=mock_with_module())
        dev_registry.get_or_create("k1").set_dmc(dmc)
        dev_registry.get_or_create("k2").set_dmc(dmc)
    
    sess.edit_config(cfg2, cont1)


########################

class Fun(ttt.RFSFunction):
    def transform_wrapper(self, cfg, device_info, memory, dynstate):
        return (gdata.Container(cfg.children), memory)

cfg3 = gdata.Container({
    q("rfs"): gdata.List([q("name")], [
        gdata.Container({
            q("name"): gdata.Leaf("k1"),
            q("base"): gdata.List([q("id")], [
                gdata.Container({
                    q("id"): gdata.Leaf("A"),
                    q("val"): gdata.Leaf("one")
                })
            ])
        }),
        gdata.Container({
            q("name"): gdata.Leaf("k2"),
            q("base"): gdata.List([q("id")], [
                gdata.Container({
                    q("id"): gdata.Leaf("A"),
                    q("val"): gdata.Leaf("two")
                })
            ])
        })
    ])
})

def rfs_for_device(dev):
    return gdata.Container({
        q('rfs'): gdata.List([q("name")], [
            gdata.Container({
                q("name"): gdata.Leaf(dev)
            })
        ])
    })

actor complete(t: testing.AsyncT):
    dev_registry = swdev.DeviceRegistry(log_handler=t.log_handler)
    stack = ttt.Layer("rfs", ttt.Container({q("rfs"): ttt.List(ttt.Container({q("base"): ttt.List(ttt.RFSTransform(Fun, dev_registry), [q("id")])}), [q("name")])}),
            ttt.Layer("devices", ttt.Container({q("devices"): ttt.Container({q("device"): ttt.List(ttt.DeviceConfig(dev_registry), [q("name")])})}),
            None))

    def reconf_cb(dev):
        cfg = rfs_for_device(dev)
        stack.edit_config(cfg)
        
    dev_registry.on_reconf(reconf_cb)
    
    def cont1(_r):
        dmc1 = DeviceMetaConfig("k1", Credentials("admin", "admin"), mock=mock_with_module())
        dmc2 = DeviceMetaConfig("k2", Credentials("admin", "admin"), mock=mock_with_module())
        k1 = dev_registry.get_or_create("k1").set_dmc(dmc1)
        k2 = dev_registry.get_or_create("k2").set_dmc(dmc2)
    
    def complete_cb(_r):
        t.success()
        
    sess = stack.newsession()
    sess.edit_config(cfg3, cont1, complete_cb)


########################

class FailingRFSTransform(ttt.RFSFunction):
    def transform_wrapper(self, cfg, device_info, memory, dynstate):
        raise AssertionError("Test RFS transform error")


class EmptyOutputRFSTransform(ttt.RFSFunction):
    def transform_wrapper(self, cfg, device_info, memory, dynstate):
        return gdata.Container(), memory


actor EmptyOutputTransformActor(notify: action() -> None):
    def on_conf(_conf: gdata.Node, _memory: ?gdata.Node):
        notify()
    def shutdown(memory: ?gdata.Node):
        pass

rfs_fail_cfg = gdata.Container({
    q("rfs"): gdata.List([q("name")], [
        gdata.Container({
            q("name"): gdata.Leaf("k1"),
            q("base"): gdata.List([q("id")], [
                gdata.Container({
                    q("id"): gdata.Leaf("A"),
                    q("val"): gdata.Leaf("one")
                })
            ])
        })
    ])
})


actor rfs_actor_notified_for_empty_output(t: testing.AsyncT):
    dev_registry = swdev.DeviceRegistry(log_handler=t.log_handler)
    var starts = 0
    var notifications = 0
    var configuring = False
    var done = False

    def notified():
        notifications += 1

    def actor_ctor(_params: ttt.TransformActorParams) -> ttt.TransformActor:
        starts += 1
        act = EmptyOutputTransformActor(notified)
        return ttt.TransformActor(act.on_conf, act.shutdown)

    stack = ttt.Layer("rfs", ttt.Container({
        q("rfs"): ttt.List(ttt.Container({
            q("base"): ttt.List(ttt.RFSTransform(
                EmptyOutputRFSTransform,
                dev_registry,
                actor_ctor,
            ), [q("id")]),
        }), [q("name")]),
    }), None)

    def fail(error: Exception):
        if done:
            return
        done = True
        t.failure(error)

    def check_notified(attempt: int=0):
        if done:
            return
        if starts == 1 and notifications == 1:
            done = True
            t.success()
        elif starts > 1 or notifications > 1 or attempt >= 100:
            fail(AssertionError(
                "Expected one actor start and notification, got {starts} and {notifications}"
            ))
        else:
            after 0.01: check_notified(attempt + 1)

    def configured(result: value):
        if isinstance(result, Exception):
            fail(result)
        else:
            after 0: check_notified()

    def timeout():
        fail(AssertionError("Timed out waiting for empty-output actor notification"))

    def reconf_cb(dev):
        if dev == "k1" and not configuring:
            configuring = True
            stack.edit_config(rfs_fail_cfg, configured)

    dev_registry.on_reconf(reconf_cb)
    dmc = DeviceMetaConfig("k1", Credentials("admin", "admin"), mock=mock_with_module())
    dev_registry.get_or_create("k1").set_dmc(dmc)
    after 3: timeout()

actor rfs_transform_exception(t: testing.AsyncT):
    dev_registry = swdev.DeviceRegistry(log_handler=t.log_handler)
    stack = ttt.Layer("rfs", ttt.Container({q("rfs"): ttt.List(ttt.Container({q("base"): ttt.List(ttt.RFSTransform(FailingRFSTransform, dev_registry), [q("id")])}), [q("name")])}),
            ttt.Sink())
    sess = stack.newsession()

    var started = False

    def reconf_cb(dev):
        if dev == "k1" and not started:
            started = True

            def cont(res):
                testing.assertEqual(isinstance(res, Exception), True)
                testing.assertEqual(sess.below().get(), gdata.Container())
                t.success()

            sess.edit_config(rfs_fail_cfg, cont)

    dev_registry.on_reconf(reconf_cb)

    dmc = DeviceMetaConfig("k1", Credentials("admin", "admin"), mock=mock_with_module())
    dev_registry.get_or_create("k1").set_dmc(dmc)


########################

actor ShutdownTransformActor(success):
    var on_confs = 0
    def on_conf(_conf: gdata.Node, _memory: ?gdata.Node):
        on_confs += 1
    def shutdown(memory: ?gdata.Node):
        if on_confs == 1:
            success()

rfs_empty_cfg = gdata.Container({
    q("rfs"): gdata.List([q("name")], [
        gdata.Container({
            q("name"): gdata.Leaf("k1"),
            q("base"): gdata.List([q("id")], [
                gdata.Absent({
                    q("id"): gdata.Leaf("A")
                })
            ])
        })
    ])
})

actor rfs_actor_notified_on_shutdown(t: testing.AsyncT):
    dev_registry = swdev.DeviceRegistry(log_handler=t.log_handler)

    def actor_ctor(_params: ttt.TransformActorParams) -> ttt.TransformActor:
        act = ShutdownTransformActor(t.success)
        return ttt.TransformActor(act.on_conf, act.shutdown)

    stack = ttt.Layer("rfs", ttt.Container({
        q("rfs"): ttt.List(ttt.Container({
            q("base"): ttt.List(ttt.RFSTransform(
                EmptyOutputRFSTransform,
                dev_registry,
                actor_ctor,
            ), [q("id")]),
        }), [q("name")]),
    }), None)

    def configured(result: value):
        stack.edit_config(rfs_empty_cfg)

    def reconf_cb(dev):
        if dev == "k1":
            stack.edit_config(rfs_fail_cfg, configured)

    dev_registry.on_reconf(reconf_cb)
    dmc = DeviceMetaConfig("k1", Credentials("admin", "admin"), mock=mock_with_module())
    dev_registry.get_or_create("k1").set_dmc(dmc)

    def timeout():
        t.failure(AssertionError("Timed out waiting for shutdown notification"))

    after 3: timeout()
