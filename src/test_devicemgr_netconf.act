"""DeviceMgr tests for adapter-level NETCONF mocking."""

import logging
import net
import testing
import yang
import yang.gdata as ygdata
import yang.schema as yschema

import device as swdev
import adapters.netconf as swna
import swyang

from device_meta_config import \
    stratoweave_rfs__device_entry as DeviceMetaConfig, \
    stratoweave_rfs__device__credentials as Credentials, \
    stratoweave_rfs__device__address_entry as Address, \
    stratoweave_rfs__device__mock as Mock

IETF_SYSTEM_NS = "urn:ietf:params:xml:ns:yang:ietf-system"
IETF_SYSTEM_MODULE = "ietf-system"

IETF_SYSTEM_YANG = r"""module ietf-system {
  yang-version "1.1";
  namespace "urn:ietf:params:xml:ns:yang:ietf-system";
  prefix sys;
  container system-state {
    config false;
    container clock {
      leaf current-datetime {
        type string;
      }
      leaf boot-datetime {
        type string;
      }
    }
  }
  rpc system-restart {
  }
  rpc set-clock {
    input {
      leaf new-datetime {
        type string;
      }
    }
    output {
      leaf old-datetime {
        type string;
      }
    }
  }
}"""

def _q(name: str) -> ygdata.Id:
    return ygdata.Id(IETF_SYSTEM_NS, name)

def _mock_oper_ds(current_datetime: str, boot_datetime: str) -> ygdata.Node:
    """Mock data for the operational datastore of the mock NETCONF server."""
    return ygdata.Container({
        _q("system-state"): ygdata.Container({
            _q("clock"): ygdata.Container({
                _q("current-datetime"): ygdata.Leaf(current_datetime, ns=IETF_SYSTEM_NS, module=IETF_SYSTEM_MODULE),
                _q("boot-datetime"): ygdata.Leaf(boot_datetime, ns=IETF_SYSTEM_NS, module=IETF_SYSTEM_MODULE)
            }, ns=IETF_SYSTEM_NS, module=IETF_SYSTEM_MODULE)
        }, ns=IETF_SYSTEM_NS, module=IETF_SYSTEM_MODULE)
    })

def _current_datetime_filter() -> ygdata.FNode:
    """Filter matching only system-state/clock/current-datetime."""
    return ygdata.FNode(None, None, [
        ygdata.FNode(_q("system-state"), children=[
            ygdata.FNode(_q("clock"), children=[
                ygdata.FNode(_q("current-datetime"))
            ])
        ])
    ])

def _boot_datetime_filter() -> ygdata.FNode:
    """Filter matching only system-state/clock/boot-datetime."""
    return ygdata.FNode(None, None, [
        ygdata.FNode(_q("system-state"), children=[
            ygdata.FNode(_q("clock"), children=[
                ygdata.FNode(_q("boot-datetime"))
            ])
        ])
    ])

def _current_datetime_from_tree(n: ?ygdata.Node) -> ?str:
    if n is not None and isinstance(n, ygdata.Container):
        sys_state = n.get_opt_cnt(_q("system-state"))
        if sys_state is not None:
            clock = sys_state.get_opt_cnt(_q("clock"))
            if clock is not None:
                leaf = clock.get_opt_leaf(_q("current-datetime"))
                if leaf is not None:
                    val = leaf.val
                    if isinstance(val, str):
                        return val
    return None

def _has_boot_datetime(n: ?ygdata.Node) -> bool:
    if n is not None and isinstance(n, ygdata.Container):
        sys_state = n.get_opt_cnt(_q("system-state"))
        if sys_state is not None:
            clock = sys_state.get_opt_cnt(_q("clock"))
            if clock is not None:
                return clock.get_opt_leaf(_q("boot-datetime")) is not None
    return False

def make_netconf_mock_dmc(name: str) -> DeviceMetaConfig:
    return DeviceMetaConfig(
        name=name,
        credentials=Credentials("admin", "admin"),
        type="netconf",
        address=[Address(name="primary", address="127.0.0.1", port=u64(830))],
        mock=Mock(enabled=True)
    )

def new_netconf_mock_device_mgr(t: testing.EnvT, name: str, on_reconf: action(str) -> None, extra_models: list[str]=[]) -> swdev.DeviceMgr:
    schema = yang.compile([IETF_SYSTEM_YANG] + extra_models)
    dev_types = {
        "netconf": swdev.DeviceType(
            name="netconf",
            adapter_type=swna.NetconfAdapter,
            src_dnode=schema
        )
    }

    schema_registry = swdev.SchemaRegistry()
    dev = swdev.DeviceMgr(dev_types, net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap))), name, t.log_handler, on_reconf, schema_registry)
    dev.set_dmc(make_netconf_mock_dmc(name))
    return dev

#################################################################################
## Tests
#################################################################################
actor _test_get_yang_library(t: testing.EnvT):
    """ietf-yang-library discovery against the mock NETCONF server.

    1. Create a DeviceMgr whose device schema bundles ietf-yang-library, so the
       mock's inventory implements it and the mock advertises + serves the
       library (rather than falling back to per-module capabilities).
    2. Wait until schema discovery has populated the module set with ietf-yang-library.
    3. Snapshot the discovered module set: the names, namespaces and revisions
       all come from the served library.
    """
    def noop_on_reconf(name: str):
        pass
    dev = new_netconf_mock_device_mgr(t, "dev-yanglib", noop_on_reconf,
        extra_models=[swyang.ietf_yang_library, swyang.ietf_yang_types,
                      swyang.ietf_inet_types, swyang.ietf_datastores])
    var done = False

    def succeed(data: ?str):
        if done:
            return
        done = True
        t.success(data)

    def start():
        if done:
            return
        mods = dev.get_modules().0
        if "ietf-yang-library" not in mods:
            after 0.01: start()
            return
        succeed("\n".join(sorted(["{m.name} {m.namespace} {m.revision}" for m in mods.values()])))

    start()


actor _test_rpc(t: testing.EnvT):
    """YANG RPC through the gdata path against the mock NETCONF server.

    1. Create DeviceMgr in NETCONF mock-server mode.
    2. Register a canned rpc-reply for set-clock on the mock server.
    3. Call DeviceMgr.rpc with the RPC as gdata: a root container holding the
       set-clock node with its input subtree.
    4. Validate the RPC output gdata (old-datetime) parsed from the reply.
    """
    mock_old_datetime = "2026-02-21T10:11:12Z"

    def noop_on_reconf(name: str):
        pass
    dev = new_netconf_mock_device_mgr(t, "dev-rpc", noop_on_reconf)
    var done = False

    def fail(msg: str):
        if done:
            return
        done = True
        t.failure(ValueError(msg))

    def succeed():
        if done:
            return
        done = True
        t.success()

    def on_reply(r: ?ygdata.Node, err: ?Exception):
        if done:
            return
        if err is not None:
            fail("Mock set-clock RPC failed: {err}")
            return
        if r is not None:
            old_datetime = r.get_opt_str(_q("old-datetime"))
            if old_datetime is not None and old_datetime == mock_old_datetime:
                succeed()
            else:
                fail("Unexpected set-clock output: {r}")
        else:
            fail("Got no RPC output when one was expected")

    def start():
        if done:
            return
        if IETF_SYSTEM_MODULE not in dev.get_modules().0:
            after 0.01: start()
            return
        msg = async dev.get_adapter()
        adapter = await msg
        if isinstance(adapter, swna.NetconfAdapter):
            mock_server = adapter.get_mock_server()
            if mock_server is not None:
                mock_server.set_rpc_reply("set-clock", ygdata.Container({
                    _q("old-datetime"): ygdata.Leaf(mock_old_datetime, ns=IETF_SYSTEM_NS, module=IETF_SYSTEM_MODULE)
                }))
                rpc_gdata = ygdata.Container({
                    _q("set-clock"): ygdata.Container({
                        _q("new-datetime"): ygdata.Leaf("2026-03-01T00:00:00Z")
                    })
                })
                dev.rpc(on_reply, rpc_gdata)
            else:
                fail("Expected NetconfMockServer from NetconfAdapter")
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    start()


actor _test_rpc_without_output(t: testing.EnvT):
    """An RPC whose model declares no output still completes.

    1. Create DeviceMgr in NETCONF mock-server mode.
    2. Register an empty reply for system-restart, which has no output.
    3. Call DeviceMgr.rpc and expect the callback to run without an error.
    """
    def noop_on_reconf(name: str):
        pass
    dev = new_netconf_mock_device_mgr(t, "dev-rpc-no-output", noop_on_reconf)
    var done = False

    def fail(msg: str):
        if done:
            return
        done = True
        t.failure(ValueError(msg))

    def on_reply(r: ?ygdata.Node, err: ?Exception):
        if done:
            return
        if err is not None:
            fail("system-restart RPC failed: {err}")
            return
        if r is None:
            fail("system-restart RPC returned no tree")
            return
        done = True
        t.success()

    def start():
        if done:
            return
        if IETF_SYSTEM_MODULE not in dev.get_modules().0:
            after 0.01: start()
            return
        msg = async dev.get_adapter()
        adapter = await msg
        if isinstance(adapter, swna.NetconfAdapter):
            mock_server = adapter.get_mock_server()
            if mock_server is not None:
                mock_server.set_rpc_reply("system-restart", ygdata.Container({}))
                dev.rpc(on_reply, ygdata.Container({
                    _q("system-restart"): ygdata.Container({})
                }))
            else:
                fail("Expected NetconfMockServer from NetconfAdapter")
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    start()
    after 2.0: fail("Timed out waiting for the RPC callback")


actor _test_subscribe_periodic(t: testing.EnvT):
    """Periodic subscription via NETCONF mock server.

    1. Create DeviceMgr in NETCONF mock-server mode with IETF system schema.
    2. Seed the mock server oper datastore with system-state/clock (both datetimes).
    3. Start a periodic subtree subscription that selects only system-state/clock/current-datetime.
    4. On the first update, validate current-datetime (and absence of boot-datetime), then mutate the mock oper datastore once.
    5. On the second update, validate the new current-datetime and remove the owner declaration.
    6. Fail fast via a short timeout if updates never arrive.
    """
    mock_current_datetime_1 = "2026-02-21T10:11:12Z"
    mock_current_datetime_2 = "2026-02-21T10:11:13Z"
    mock_boot_datetime = "2025-12-31T00:00:00Z"

    var updates = 0
    var done = False
    var mock_server: ?swna.NetconfMockServer = None

    def noop_on_reconf(name: str):
        pass
    dev = new_netconf_mock_device_mgr(t, "dev-sub", noop_on_reconf)

    def fail(msg: str):
        if done:
            return
        done = True
        t.failure(ValueError(msg))

    def succeed():
        if done:
            return
        done = True
        t.success()

    def on_update(n: ?ygdata.Node, err: ?Exception):
        if done:
            return
        if err is not None:
            fail("Subscription update error: {err}")
            return
        dt = _current_datetime_from_tree(n)
        if dt is None:
            fail("Subscription update missing current-datetime")
            return
        if _has_boot_datetime(n):
            fail("Subscription update should not include boot-datetime")
            return

        updates += 1
        if updates == 1:
            if dt != mock_current_datetime_1:
                fail("Unexpected first datetime: {dt}")
                return
            if mock_server is not None:
                mock_server.set_oper_ds(_mock_oper_ds(mock_current_datetime_2, mock_boot_datetime))
            else:
                fail("Missing mock server for subscription update")
                return
        elif updates == 2:
            if dt != mock_current_datetime_2:
                fail("Unexpected second datetime: {dt}")
                return
            dev.remove_subscriptions("test-subscribe-periodic")
            succeed()
        else:
            fail("Unexpected extra subscription update: {updates}")

    def start():
        adapter = dev.get_adapter()
        if isinstance(adapter, swna.NetconfAdapter):
            mock_server = adapter.get_mock_server()
            if mock_server is not None:
                mock_server.set_oper_ds(_mock_oper_ds(mock_current_datetime_1, mock_boot_datetime))
                want = set([ygdata.SubscriptionSpec(_current_datetime_filter(), period=0.05)])
                dev.declare_subscriptions("test-subscribe-periodic", on_update, want)
            else:
                fail("Expected NetconfMockServer from NetconfAdapter")
                return
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    start()

    after 2.0: fail("Timed out waiting for periodic subscription updates")


# The ietf-yang-push import closure (minus ietf-yang-library, so the mock advertises
# per-module caps and the client discovers ietf-yang-push directly): enough for the
# mock to advertise yang-push so the adapter establishes a real on-change subscription.
YP_CLOSURE: list[str] = [
    swyang.ietf_datastores,
    swyang.ietf_yang_types,
    swyang.ietf_inet_types,
    swyang.ietf_yang_push,
    swyang.ietf_subscribed_notifications,
    swyang.ietf_restconf,
    swyang.ietf_yang_patch,
    swyang.ietf_interfaces,
    swyang.ietf_netconf_acm,
    swyang.ietf_network_instance,
    swyang.ietf_ip,
    swyang.ietf_yang_schema_mount,
]


actor _test_subscribe_on_change(t: testing.EnvT):
    """On-change subscription via the device adapter against a yang-push-capable mock.

    1. DeviceMgr in mock mode whose schema advertises ietf-yang-push, so the adapter
       establishes a real on-change subscription (not poll emulation).
    2. Seed oper data and subscribe on-change; the sync-on-start baseline is update 1.
    3. On the baseline, mutate the oper datastore once; the mock emits a
       push-change-update whose yang-patch the adapter applies onto the subscription
       tree.
    4. On update 2, assert the applied current-datetime, then tear down.
    """
    mock_current_datetime_1 = "2026-02-21T10:11:12Z"
    mock_current_datetime_2 = "2026-02-21T10:11:13Z"
    mock_boot_datetime = "2025-12-31T00:00:00Z"

    var updates = 0
    var done = False
    var mock_server: ?swna.NetconfMockServer = None

    def noop_on_reconf(name: str):
        pass
    dev = new_netconf_mock_device_mgr(t, "dev-onchange", noop_on_reconf, extra_models=YP_CLOSURE)

    def fail(msg: str):
        if done:
            return
        done = True
        t.failure(ValueError(msg))

    def succeed():
        if done:
            return
        done = True
        t.success()

    def on_update(n: ?ygdata.Node, err: ?Exception):
        if done:
            return
        if err is not None:
            fail("Subscription update error: {err}")
            return
        dt = _current_datetime_from_tree(n)
        if dt is None:
            fail("Subscription update missing current-datetime")
            return

        updates += 1
        if updates == 1:
            if dt != mock_current_datetime_1:
                fail("Unexpected baseline datetime: {dt}")
                return
            ms = mock_server
            if ms is not None:
                ms.set_oper_ds(_mock_oper_ds(mock_current_datetime_2, mock_boot_datetime))
            else:
                fail("Missing mock server for on-change update")
                return
        elif updates == 2:
            if dt != mock_current_datetime_2:
                fail("Unexpected on-change datetime: {dt}")
                return
            dev.remove_subscriptions("test-subscribe-on-change")
            succeed()
        else:
            fail("Unexpected extra subscription update: {updates}")

    def start():
        adapter = dev.get_adapter()
        if isinstance(adapter, swna.NetconfAdapter):
            mock_server = adapter.get_mock_server()
            ms = mock_server
            if ms is not None:
                ms.set_oper_ds(_mock_oper_ds(mock_current_datetime_1, mock_boot_datetime))
                want = set([ygdata.SubscriptionSpec(None, on_change=True)])
                dev.declare_subscriptions("test-subscribe-on-change", on_update, want)
            else:
                fail("Expected NetconfMockServer from NetconfAdapter")
                return
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    start()

    after 2.0: fail("Timed out waiting for on-change subscription updates")


