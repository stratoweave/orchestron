actor _test_classic_bootfile(t: testing.AsyncT):
    reg = ztpreg.ZtpRegistry(t.log_handler)
    router = http_router.Router()
    ztpclassic.ClassicZtpServer(router, reg, t.log_handler)
    reg.register_device("rtr1", make_ztp_dmc("rtr1"))

    def respond(s: int, h: dict[str, str], b: str):
        testing.assertEqual(s, 200)
        testing.assertIn("#!/bin/bash", b)
        testing.assertIn("xrapply_string", b)
        t.success()

    def fire():
        router.serve(http.Request("GET", "/ztp/v1/device/rtr1/bootfile", b"HTTP/1.1", {"host": "192.0.2.1"}, b""), respond)
    after 0.1: fire()

