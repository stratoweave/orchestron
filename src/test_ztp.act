def _test_day0_xr_config() -> str:
    return ztpreg.day0_native_config(make_state("rtr1"))

def _test_day0_xr_bootfile() -> str:
    return ztpreg.day0_bootfile(make_state("rtr1"), "http://192.0.2.1:80", "192.0.2.1")

def _test_day0_xe_python() -> str:
    return ztpreg.day0_bootfile(make_state("rtr2", fmt="xe-python"), "http://192.0.2.1:80", "192.0.2.1")

def _test_day0_override():
    st = make_state("rtr1", day0="my config\n")
    testing.assertEqual(ztpreg.day0_native_config(st), "my config\n")
    testing.assertEqual(ztpreg.day0_bootfile(st, "http://h", "h"), "my config\n")


#################################################################################
## Registry lifecycle
#################################################################################

actor _test_registry_disabled(t: testing.AsyncT):
    reg = ztpreg.ZtpRegistry(t.log_handler)

    def check():
        if reg.get("rtr1") is not None:
            t.failure(AssertionError("disabled device should not be registered"))
            return
        t.success()

    reg.register_device("rtr1", make_ztp_dmc("rtr1", ztp_enabled=False))
    after 0.05: check()

actor _test_registry_lifecycle(t: testing.AsyncT):
    reg = ztpreg.ZtpRegistry(t.log_handler)

    var activated_name: ?str = None
    var activated_address: ?str = None

    def check():
        st = reg.get("rtr1")
        if st is not None:
            testing.assertEqual(activated_name, "rtr1")
            testing.assertEqual(activated_address, "192.0.2.55")
            testing.assertEqual(st.phase, ztpreg.PHASE_BOOTSTRAPPED)
            testing.assertNotNone(st.discovered_address)
            # serial matching: by serial and by name
            testing.assertNotNone(reg.match("SN1234"))
            testing.assertNotNone(reg.match("rtr1"))
            testing.assertNone(reg.match("nonexistent"))
            t.success()
        else:
            t.failure(AssertionError("rtr1 not registered"))

    def on_activate(name: str, address: str):
        activated_name = name
        activated_address = address
        check()

    reg.on_activate(on_activate)
    reg.register_device("rtr1", make_ztp_dmc("rtr1", serial="SN1234"))
    reg.record_progress("rtr1", "sztp", "bootstrap-initiated", "starting")
    reg.record_progress("rtr1", "sztp", "bootstrap-complete", "done")
    reg.discovered("rtr1", "192.0.2.55")


#################################################################################
## SZTP HTTP handlers
#################################################################################

actor _test_sztp_get_bootstrapping_data(t: testing.AsyncT):
    reg = ztpreg.ZtpRegistry(t.log_handler)
    router = http_router.Router()
    ztpsztp.SztpServer(router, reg, t.log_handler)
    reg.register_device("rtr1", make_ztp_dmc("rtr1", serial="SN1"))

    var status = -1
    var body = ""
    def respond(s: int, h: dict[str, str], b: str):
        status = s
        body = b
        check()

    def check():
        testing.assertEqual(status, 200)
        # output carries the base64 CMS conveyed-information
        decoded = json.decode(body)
        out = decoded.get("ietf-sztp-bootstrap-server:output")
        if isinstance(out, dict):
            testing.assertNotNone(out.get("conveyed-information"))
            t.success()
        else:
            t.failure(AssertionError("no output in response"))

    # Basic auth username = serial number (RFC 8572)
    auth = "Basic " + base64.encode("SN1:x".encode()).decode()
    def fire():
        router.serve(http.Request("POST", ztpsztp.OP_GET_BOOTSTRAPPING_DATA, b"HTTP/1.1", {"authorization": auth}, b"{}"), respond)
    after 0.1: fire()

actor _test_sztp_unknown_device(t: testing.AsyncT):
    reg = ztpreg.ZtpRegistry(t.log_handler)
    router = http_router.Router()
    ztpsztp.SztpServer(router, reg, t.log_handler)
    reg.register_device("rtr1", make_ztp_dmc("rtr1", serial="SN1"))

    def respond(s: int, h: dict[str, str], b: str):
        testing.assertEqual(s, 404)
        t.success()

    def fire():
        router.serve(http.Request("POST", ztpsztp.OP_GET_BOOTSTRAPPING_DATA, b"HTTP/1.1", {"x-sztp-serial": "nope"}, b"{}"), respond)
    after 0.1: fire()

actor _test_sztp_disabled(t: testing.AsyncT):
    reg = ztpreg.ZtpRegistry(t.log_handler)
    router = http_router.Router()
    ztpsztp.SztpServer(router, reg, t.log_handler)
    # ZTP enabled but the SZTP mechanism disabled -> not served
    reg.register_device("rtr1", make_ztp_dmc("rtr1", serial="SN1", sztp_enabled=False))

    def respond(s: int, h: dict[str, str], b: str):
        testing.assertEqual(s, 404)
        t.success()

    def fire():
        router.serve(http.Request("POST", ztpsztp.OP_GET_BOOTSTRAPPING_DATA, b"HTTP/1.1", {"x-sztp-serial": "SN1"}, b"{}"), respond)
    after 0.1: fire()

actor _test_sztp_signed_data_preferred(t: testing.AsyncT):
    reg = ztpreg.ZtpRegistry(t.log_handler)
    router = http_router.Router()
    ztpsztp.SztpServer(router, reg, t.log_handler)
    reg.register_device("rtr1", make_ztp_dmc("rtr1", serial="SN1"))

    def respond(s: int, h: dict[str, str], b: str):
        # We cannot produce signed data -> must not return unsigned onboarding info
        testing.assertEqual(s, 404)
        t.success()

    def fire():
        body = r'{"ietf-sztp-bootstrap-server:input": {"signed-data-preferred": [null]}}'
        router.serve(http.Request("POST", ztpsztp.OP_GET_BOOTSTRAPPING_DATA, b"HTTP/1.1", {"x-sztp-serial": "SN1"}, body.encode()), respond)
    after 0.1: fire()

actor _test_sztp_report_progress(t: testing.AsyncT):
    reg = ztpreg.ZtpRegistry(t.log_handler)
    router = http_router.Router()
    ztpsztp.SztpServer(router, reg, t.log_handler)
    reg.register_device("rtr1", make_ztp_dmc("rtr1", serial="SN1"))

    def respond(s: int, h: dict[str, str], b: str):
        # RFC 8572: report-progress returns 204 No Content
        testing.assertEqual(s, 204)
        st = reg.get("rtr1")
        if st is not None:
            found = False
            for p in st.progress:
                if p.ptype == "bootstrap-complete":
                    found = True
            testing.assertTrue(found)
            testing.assertEqual(len(st.ssh_host_keys), 1)
            t.success()
        else:
            t.failure(AssertionError("device missing"))

    def fire():
        body = '<input xmlns="urn:ietf:params:xml:ns:yang:ietf-sztp-bootstrap-server"><progress-type>bootstrap-complete</progress-type><message>done</message><ssh-host-keys><ssh-host-key><algorithm>ssh-rsa</algorithm><key-data>AAAA</key-data></ssh-host-key></ssh-host-keys></input>'
        router.serve(http.Request("POST", ztpsztp.OP_REPORT_PROGRESS, b"HTTP/1.1", {"x-sztp-serial": "SN1"}, body.encode()), respond)
    after 0.1: fire()


