        t.success()

    def fire():
        router.serve(http.Request("POST", "/ztp/v1/device/rtr1/checkin", b"HTTP/1.1", {}, b""), respond)
    after 0.1: fire()


#################################################################################
## DeviceMgr discovered-address activation (integration through DeviceRegistry)
#################################################################################

actor _test_devicemgr_discovered_address(t: testing.AsyncT):
    """ZtpRegistry.discovered -> DeviceRegistry._ztp_activate -> DeviceMgr"""
    ztpr = ztpreg.ZtpRegistry(t.log_handler)
    # connect_cap=None -> system mock mode, no real device connection
    dev_registry = swdev.DeviceRegistry({}, None, t.log_handler, ztpr)

    dev = dev_registry.get_or_create("rtr1")
    # ZTP-enabled device with no configured address
    dev.set_dmc(make_ztp_dmc("rtr1", serial="SN9"))

    def check():
        # The discovered address propagated all the way to the DeviceMgr
        testing.assertEqual(dev.get_discovered_address(), "172.31.255.7")
        # Idempotent: a second identical discovery is a no-op (no crash)
        ztpr.discovered("rtr1", "172.31.255.7")
        t.success()

    def drive():
        ztpr.discovered("rtr1", "172.31.255.7")
        after 0.1: check()

    # let set_dmc register the device with the ZTP registry first
    after 0.1: drive()


#################################################################################
## Additional registry behaviors
#################################################################################

actor _test_registry_failure_phase(t: testing.AsyncT):
    reg = ztpreg.ZtpRegistry(t.log_handler)
    reg.register_device("rtr1", make_ztp_dmc("rtr1"))

    def check():
        st = reg.get("rtr1")
        if st is not None:
            testing.assertEqual(st.phase, ztpreg.PHASE_FAILED)
            t.success()
        else:
            t.failure(AssertionError("device missing"))

    reg.record_progress("rtr1", "classic", "bootstrap-initiated", "go")
    reg.record_progress("rtr1", "classic", "config-error", "boom")
    after 0.05: check()

actor _test_registry_deregister(t: testing.AsyncT):
    reg = ztpreg.ZtpRegistry(t.log_handler)
    reg.register_device("rtr1", make_ztp_dmc("rtr1"))

    def check():
        # re-registering with ztp disabled drops the device
        if reg.get("rtr1") is None:
            t.success()
        else:
            t.failure(AssertionError("device should have been dropped"))

    def disable():
        reg.register_device("rtr1", make_ztp_dmc("rtr1", ztp_enabled=False))
        after 0.05: check()

    after 0.05: disable()

def _test_day0_raw_requires_config():
    # format=raw with no day0-config has nothing to render -> error
    st = make_state("rtr1", fmt="raw")
    raised = False
    try:
        ignore = ztpreg.day0_native_config(st)
    except ValueError:
        raised = True
    testing.assertTrue(raised)
