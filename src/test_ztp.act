actor _test_classic_checkin(t: testing.AsyncT):
    reg = ztpreg.ZtpRegistry(t.log_handler)
    router = http_router.Router()
    ztpclassic.ClassicZtpServer(router, reg, t.log_handler)
    reg.register_device("rtr1", make_ztp_dmc("rtr1"))

    var got_204 = False

    # discovered() is async; assert in the activation callback it triggers
    def on_activate(name: str, address: str):
        testing.assertTrue(got_204)
        testing.assertEqual(name, "rtr1")
        testing.assertEqual(address, "172.31.255.5")
        st = reg.get("rtr1")
        if st is not None:
            testing.assertEqual(st.discovered_address, "172.31.255.5")
            t.success()
        else:
            t.failure(AssertionError("device missing"))

    def respond(s: int, h: dict[str, str], b: str):
        testing.assertEqual(s, 204)
        got_204 = True

    reg.on_activate(on_activate)
    def fire():
        router.serve(http.Request("POST", "/ztp/v1/device/rtr1/checkin?address=172.31.255.5", b"HTTP/1.1", {}, b""), respond)
    after 0.1: fire()

actor _test_classic_checkin_no_address(t: testing.AsyncT):
    reg = ztpreg.ZtpRegistry(t.log_handler)
