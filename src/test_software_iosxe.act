#
# How to mock a device software upgrade.
#
# This shows how to build a software adapter and mock the device it talks to.
# It has a trimmed IOS XE schema, a mock that answers the install RPCs and
# moves its own operational data as a result, and a test that drives the
# adapter through a whole upgrade and watches the reported version change.
#
# The interesting part is the mock. Answering an RPC with <ok/> proves nothing;
# what makes the mock useful is that `activate` changes the version the device
# reports, so the adapter's follow-up get observes the effect. That is the seam
# to copy when mocking a real platform.
#

import logging
import net
import testing
import std.xml as xml
import yang
import yang.gdata as ygdata

import device as swdev
import adapters.netconf as swna
import adapters.software_iosxe as swxe

from device_meta_config import \
    stratoweave_rfs__device_entry as DeviceMetaConfig, \
    stratoweave_rfs__device__credentials as Credentials

OLD_VERSION = "17.15.01a"
NEW_VERSION = "17.18.03a"

# Trimmed to the shape this example needs. The real modules carry many more
# leaves and several more RPCs; the names here are the real ones so the mapping
# to Cisco's models is visible.
INSTALL_RPC_YANG = r"""module Cisco-IOS-XE-install-rpc {
  yang-version "1.1";
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XE-install-rpc";
  prefix ios-xe-install-rpc;

  grouping install-common {
    leaf uuid {
      description "Correlates the RPC with its progress notifications.";
      type string;
      mandatory true;
    }
  }

  rpc install {
    description "Download and add a software image.";
    input {
      uses install-common;
      leaf path { type string; }
    }
  }
  rpc activate {
    description "Activate the added image. Impacting: the device reloads.";
    input { uses install-common; }
  }
  rpc rollback {
    description "Return to the previously activated image.";
    input { uses install-common; }
  }
  rpc remove {
    description "Remove superseded images.";
    input { uses install-common; }
  }
}
"""

INSTALL_OPER_YANG = r"""module Cisco-IOS-XE-install-oper {
  yang-version "1.1";
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XE-install-oper";
  prefix ios-xe-install-oper;

  container install-oper-data {
    config false;
    container install-version-state {
      leaf version { type string; }
    }
  }
}
"""


def _oper_ds(version: str) -> ygdata.Node:
    """The device's operational data, as the mock reports it."""
    return ygdata.Container({
        swxe.oper_q("install-oper-data"): ygdata.Container({
            swxe.oper_q("install-version-state"): ygdata.Container({
                swxe.oper_q("version"): ygdata.Leaf(version,
                    ns=swxe.INSTALL_OPER_NS, module=swxe.INSTALL_OPER_MODULE)
            }, ns=swxe.INSTALL_OPER_NS, module=swxe.INSTALL_OPER_MODULE)
        }, ns=swxe.INSTALL_OPER_NS, module=swxe.INSTALL_OPER_MODULE)
    })


actor IosXeSoftwareMock(mock_server: swna.NetconfMockServer, log_handler: logging.Handler,
                        fail_rpc: ?str=None):
    """A pretend IOS XE box, as far as software installs are concerned.

    Holds the two pieces of state a real device would: which image has been
    added, and which one is running. The RPCs move that state, and every change
    is written back into the mock server's operational datastore so a later get
    sees it.
    """
    _log = logging.Logger(log_handler)

    var running: str = OLD_VERSION
    var added: ?str = None
    var previous: ?str = None
    var rpcs: list[str] = []

    def _publish() -> None:
        mock_server.set_oper_ds(_oper_ds(running))

    def _on_rpc(request: xml.Node,
                respond: action(children: ?list[xml.Node], tag: ?str, message: ?str) -> None) -> None:
        rpcs.append(request.tag)
        if fail_rpc == request.tag:
            respond(tag="operation-failed", message="mock: {request.tag} failed")
        elif request.tag == "install":
            # A real install downloads the image named by path. Record that an
            # image is staged; nothing observable changes yet.
            added = NEW_VERSION
            respond([])
        elif request.tag == "activate":
            a = added
            if a is not None:
                previous = running
                running = a
                added = None
                _publish()
                respond([])
            else:
                # The device would refuse: nothing has been added to activate.
                respond(tag="operation-failed", message="no image has been added")
        elif request.tag == "rollback":
            p = previous
            if p is not None:
                running = p
                previous = None
                _publish()
                respond([])
            else:
                respond(tag="operation-failed", message="nothing to roll back to")
        elif request.tag == "remove":
            respond([])
        else:
            respond(tag="operation-not-supported",
                    message="IOS XE software mock does not do {request.tag}")

    def attach() -> None:
        """Install the callback and seed the datastore with the running image."""
        _publish()
        mock_server.set_rpc_cb(_on_rpc)

    def get_rpcs() -> list[str]:
        """RPCs the device was asked to run, in order."""
        return rpcs


def new_iosxe_mock_device_mgr(t: testing.EnvT, name: str,
                              on_reconf: action(str) -> None) -> swdev.DeviceMgr:
    schema = yang.compile([INSTALL_RPC_YANG, INSTALL_OPER_YANG])
    dev_types = {
        "iosxe": swdev.DeviceType(
            name="iosxe",
            adapter_type=swna.NetconfAdapter,
            src_dnode=schema,
            oper_src_dnode=schema,
            software_adapter_type=swxe.IosXeSoftwareAdapter)
    }
    dev = swdev.DeviceMgr(dev_types,
                          net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap))),
                          name, t.log_handler, on_reconf, swdev.SchemaRegistry())
    dmc = DeviceMetaConfig(name, Credentials("admin", "admin"), type="iosxe")
    dmc.mock.enabled = True
    dev.set_dmc(dmc)
    return dev


actor _test_iosxe_install_through_the_software_manager(t: testing.EnvT):
    """Install driven the way it will be in production.

    Config carrying a target release goes to DeviceMgr, which hands it to the
    SoftwareManager, which calls install on the adapter DeviceMgr built from
    the device type. The mock activates the image and moves the version it
    reports, and the status comes back as succeeded.
    """
    var done = False
    var dev_ref: ?swdev.DeviceMgr = None

    def fail(msg: str):
        if done:
            return
        done = True
        t.failure(ValueError(msg))

    var mock: ?IosXeSoftwareMock = None

    def on_version(version: ?ygdata.Node, err: ?Exception) -> None:
        if done:
            return
        if err is not None:
            fail("reading the version back failed: {err}")
            return
        got: ?str = None
        if version is not None:
            oper = version.get_opt_cnt(swxe.oper_q("install-oper-data"))
            if oper is not None:
                state = oper.get_opt_cnt(swxe.oper_q("install-version-state"))
                if state is not None:
                    got = state.get_opt_str(swxe.oper_q("version"))
        if got != NEW_VERSION:
            fail("device should report {NEW_VERSION} after the install, got {got}")
            return
        m = mock
        if m is not None:
            testing.assertEqual(m.get_rpcs(), ["install", "activate"],
                                "unexpected RPCs on the device")
            done = True
            t.success()

    def on_software_state(dev_name: str) -> None:
        """DeviceMgr republishes on a software status change."""
        if done:
            return
        d = dev_ref
        if d is not None:
            if d.get_swmgr().get_status() == "succeeded":
                d.get(on_version, swxe.running_version_filter())

    def start():
        if done:
            return
        d = dev_ref
        if d is not None:
            if "Cisco-IOS-XE-install-oper" not in d.get_modules().0:
                after 0.01: start()
                return
            msg = async d.get_adapter()
            dev_adapter = await msg
            if isinstance(dev_adapter, swna.NetconfAdapter):
                mock_server = dev_adapter.get_mock_server()
                if mock_server is not None:
                    m = IosXeSoftwareMock(mock_server, t.log_handler)
                    mock = m
                    m.attach()
                    # The only thing that kicks off an install: intent saying
                    # which release the device should be running.
                    d.get_swmgr().set_config("camp-1", NEW_VERSION, False, {})
                else:
                    fail("Expected NetconfMockServer from NetconfAdapter")
            else:
                fail("Expected NetconfAdapter from DeviceMgr")

    dev_ref = new_iosxe_mock_device_mgr(t, "dev-iosxe", on_software_state)
    start()


actor _test_iosxe_device_failure_is_reported(t: testing.EnvT):
    """A device that refuses an install leaves the manager in failed."""
    var done = False
    var dev_ref: ?swdev.DeviceMgr = None

    def on_software_state(dev_name: str) -> None:
        if done:
            return
        d = dev_ref
        if d is not None:
            status = d.get_swmgr().get_status()
            if status == "failed":
                done = True
                t.success()
            elif status == "succeeded":
                done = True
                t.failure(ValueError("activate failed but the manager reported success"))

    def start():
        if done:
            return
        d = dev_ref
        if d is not None:
            if "Cisco-IOS-XE-install-oper" not in d.get_modules().0:
                after 0.01: start()
                return
            msg = async d.get_adapter()
            dev_adapter = await msg
            if isinstance(dev_adapter, swna.NetconfAdapter):
                mock_server = dev_adapter.get_mock_server()
                if mock_server is not None:
                    m = IosXeSoftwareMock(mock_server, t.log_handler, "activate")
                    m.attach()
                    d.get_swmgr().set_config("camp-1", NEW_VERSION, False, {})
                else:
                    t.failure(ValueError("Expected NetconfMockServer"))
            else:
                t.failure(ValueError("Expected NetconfAdapter"))

    dev_ref = new_iosxe_mock_device_mgr(t, "dev-iosxe-fail", on_software_state)
    start()
