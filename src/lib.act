import aon
import argconf
import file
import logging
import net

import tmf.cfs

import app as swapp
import db as swdb
import db.etcd as swetcd
import db.lmdb as swlmdb
import device as swdev
import http_server as swhttp
import netconf_server as swnetconf
import test_rig as swts


# Reserve a 1 TiB virtual map; LMDB grows physical storage with its data.
TTT_DB_MAP_SIZE = 1 << 40


def main(sysspec: swapp.SysSpec, env: Env, http: bool=True, netconf: bool=True,
         system_settings_files: ?list[str]=None,
         system_settings: ?list[dict[str, ?value]]=None,
         static_assets: ?dict[str, str]=None):
    """Start a production StratoWeave application.

    This entrypoint wires together the standard runtime components used by a
    StratoWeave application: the device registry, the Transactional Transform
    Layer (TTT) stack, optional HTTP server, and startup config loader.

    Args:
        sysspec: Generated system specification for the application
        env: The main actor Env object, required to access capabilities
        http (bool): When `True`, start the built-in HTTP server
        system_settings_files: AON system settings files, in precedence order
        system_settings: Decoded AON system settings applied after the files
        static_assets: Optional embedded static assets (URL path -> text
            content, e.g. a built web UI) served by the HTTP server alongside
            the APIs, with SPA fallback; see the static_assets module

    Startup behavior:
        Any startup config files provided on the command line are merged and
        applied to the top layer as startup configuration.

    Use it from the main actor:

        import stratoweave
        import awesome_app.sysspec

        actor main(env):
            stratoweave.main(
                awesome_app.sysspec.SYSSPEC,
                env,
                system_settings_files=["system.aon"]
            )
    """
    try:
        all_system_settings: list[dict[str, ?value]] = []
        filenames = system_settings_files
        if filenames is not None:
            rfcap = file.ReadFileCap(file.FileCap(env.cap))
            for filename in filenames!:
                try:
                    f = file.ReadFile(rfcap, filename)
                    data = f.read()
                    f.close()
                    all_system_settings.append(aon.decode(data.decode(), filename))
                except Exception as exc:
                    raise argconf.ConfigurationError(
                        "Cannot load system settings '{filename}': {exc}"
                    )
        supplied = system_settings
        if supplied is not None:
            for settings in supplied!:
                all_system_settings.append(settings)

        environment: dict[str, str] = {}
        for name in swapp.SystemSettings.parser().environment_variables():
            val = env.getenv(name)
            if val is not None:
                environment[name] = val!
        resolved_settings = swapp.SystemSettings.parse(
            env.argv, all_system_settings, environment
        )
        _start(sysspec, env, resolved_settings, http, netconf, static_assets)
    except argconf.PrintHelp as exc:
        print(str(exc))
        env.exit(0)
        return
    except argconf.ConfigurationError as exc:
        print(str(exc), err=True)
        env.exit(1)
        return


def _start(sysspec: swapp.SysSpec, env: Env,
           system_settings: swapp.SystemSettings,
           http: bool, netconf: bool,
           static_assets: ?dict[str, str]=None):
    fcap = file.FileCap(env.cap)
    rfcap = file.ReadFileCap(fcap)

    logh = logging.Handler("SWeave")
    logh.add_sink(logging.StdoutSink())
    logh.set_output_level(logging.TRACE)

    logh_http = logging.Handler("HTTP")
    logh_http.set_handler(logh)
    logh_http.set_output_level(logging.DEBUG)

    logh_netconf = logging.Handler("NETCONF")
    logh_netconf.set_handler(logh)
    logh_netconf.set_output_level(logging.DEBUG)

    logh_ttt = logging.Handler("TTT")
    logh_ttt.set_handler(logh)
    logh_ttt.set_output_level(logging.INFO)

    logh_dev = logging.Handler("Dev")
    logh_dev.set_handler(logh)

    log = logging.Logger(logh)

    top_schema = sysspec.schema_for_layer(0)
    top_oper_schema = sysspec.schema_for_oper_layer(0)
    connect_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(env.cap)))
    db: ?swdb.Store = None
    db_spec = system_settings.db_spec
    if db_spec is not None:
        spec = swdb.parse_store_spec(db_spec)
        if spec.backend == "lmdb":
            db = swlmdb.LmdbStore(file.WriteFileCap(fcap), spec.target, TTT_DB_MAP_SIZE)
        elif spec.backend == "etcd":
            db = swetcd.EtcdStore(connect_cap, spec.target, spec.port!, spec.prefix)
        else:
            raise ValueError("Database backend is not available: {spec.backend}")

    dev_registry = swdev.DeviceRegistry(sysspec.device_types, connect_cap, logh_dev)
    cfs = sysspec.get_layers(dev_registry, logh_ttt, db)
    swapp.RfsReconf(dev_registry, cfs)

    def start_runtime(netconf_host_key: ?str):
        if http:
            tcpl_cap = net.TCPListenCap(net.TCPCap(net.NetCap(env.cap)))
            enable_tmf = len(tmf.cfs.services_from_schema(top_schema)) > 0
            swhttp.HttpServer(tcpl_cap, top_schema=top_schema, cfs=cfs, dev_registry=dev_registry, schema_for_layer=sysspec.schema_for_layer, static_assets=static_assets, enable_tmf_api=enable_tmf, log_handler=logh_http, port=system_settings.http_port)

        if netconf:
            nc_listen_cap = net.TCPListenCap(net.TCPCap(net.NetCap(env.cap)))
            swnetconf.NetconfServer(nc_listen_cap, log_handler=logh_netconf, top_schema=top_schema, cfs=cfs, port=system_settings.netconf_port, username=system_settings.netconf_user, password=system_settings.netconf_password, host_key=netconf_host_key, subscription_schema=top_oper_schema)

        swapp.StartupConfigApplier(system_settings.startup_config_files, system_settings.exit_on_done, top_schema, cfs, env.exit, rfcap, logh)
        log.info("StratoWeave running..")

    swapp.StartupBootstrap(cfs, db is not None, system_settings.netconf_host_key_path if netconf else None, rfcap, start_runtime, env.exit, logh)

def test_main(sysspec: swapp.SysSpec, log_handler: logging.Handler) -> swts.TestRig:
    """Create a `TestRig` for actor-based StratoWeave tests.

    This entrypoint wires the minimal runtime components required for testing.

    Args:
        sysspec: Generated system specification for the application under test.
        log_handler: Logging handler used by the created device registry and
            layers so test output is routed through the test framework.

    Returns:
        TestRig: Helper object for applying config, inspecting layer state,
            and capturing device configuration snapshswts.

    Use it from a test actor:

        import stratoweave
        import awesome_app.layers.y_0 as cfs_layer
        import awesome_app.sysspec

        actor _test_netinfra(t):
            root = cfs_layer.root()
            root.netinfra.router.create("rtr1")
            input_config = root.to_gdata()

            tr = stratoweave.test_main(awesome_app.sysspec.SYSSPEC, t.log_handler)
            def cont(_r):
                t.success(tr.device_adata_snapshot())
            tr.edit_config(input_config, cont)
    """
    return swts.TestRig.build(sysspec, log_handler)
