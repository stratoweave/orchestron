#
# SoftwareManager install, driven against the loopback adapter.
#
# No device, no NETCONF, no schema: MockSoftwareAdapter answers in memory, so
# these cover the manager's own behaviour rather than any platform's. Each
# test drives its DeviceMgr's own manager and observes the published
# device/software/state subtree through the DeviceMgr's update_oper hook,
# the same payload the TTT device entry receives.
#

import logging
import net
import testing

import device as swdev
import device_oper as swdevoper
import adapters.software_mock as swmock
import yang.gdata as ygdata

OLD = "17.15.01a"
NEW = "17.18.03a"


def _devmgr(t: testing.EnvT, on_reconf: action(str) -> None) -> swdev.DeviceMgr:
    """The manager resyncs its DeviceMgr after installing, so it needs one.
    This device has no type, so it never connects to anything."""
    return swdev.DeviceMgr({}, net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap))),
                           "test-device", t.log_handler, on_reconf, swdev.SchemaRegistry())


def _pub_status(oper: ?ygdata.Node) -> ?str:
    """The status leaf out of a published device entry oper tree."""
    if oper is not None:
        return swdevoper.stratoweave_rfs__device_entry.from_gdata(oper).software.state.status
    return None


def _pub_running(oper: ?ygdata.Node) -> ?str:
    """The running-release leaf out of a published device entry oper tree."""
    if oper is not None:
        return swdevoper.stratoweave_rfs__device_entry.from_gdata(
            oper).software.state.running_release
    return None


actor _test_target_release_installs(t: testing.EnvT):
    """Intent naming a target release is the only thing that starts an install."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)

    def on_state(oper: ?ygdata.Node) -> None:
        if _pub_status(oper) == "succeeded":
            # Compare first, because install is impacting. Then two steps: the
            # image has to be staged before it can be added. No post-checks are
            # registered, so commit follows at once. The trailing check reads
            # the new release back for the oper tree.
            testing.assertEqual(adapter.calls(), ["check", "prepare", "install", "commit", "check"],
                                "manager should have compared, staged, installed")
            t.success()

    dev.set_update_oper(on_state)
    mgr = dev.get_swmgr()
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_running_release_moves(t: testing.EnvT):
    """The adapter reports the new release afterwards, as a device would."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)

    def on_state(oper: ?ygdata.Node) -> None:
        if _pub_status(oper) == "succeeded":
            testing.assertEqual(adapter.running(), NEW,
                                "device should be on the target release")
            t.success()

    dev.set_update_oper(on_state)
    mgr = dev.get_swmgr()
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_no_target_release_does_nothing(t: testing.EnvT):
    """A device with no target is left alone."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)

    def on_state(oper: ?ygdata.Node) -> None:
        # Registration pushes the current state, so only a change fails.
        status = _pub_status(oper)
        if status != "unknown":
            t.failure(ValueError("status should not have changed, got {status}"))

    def verify() -> None:
        testing.assertEqual(adapter.calls(), [], "nothing should have run")
        t.success()

    dev.set_update_oper(on_state)
    mgr = dev.get_swmgr()
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", None, False, {})
    after 0.05: verify()


actor _test_veto_blocks_the_install(t: testing.EnvT):
    """A veto from any holder stops the impacting step before it starts."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status != "unknown":
            t.failure(ValueError("status should not have changed, got {status}"))

    def verify() -> None:
        testing.assertEqual(adapter.calls(), [], "install must not run under veto")
        t.success()

    dev.set_update_oper(on_state)
    mgr = dev.get_swmgr()
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {"noc-monitoring": "maintenance freeze"})
    after 0.05: verify()


actor _test_failed_install_is_reported(t: testing.EnvT):
    """A device that refuses the install leaves the manager in failed."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD, "install")
    dev = _devmgr(t, noop_on_reconf)

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status == "failed":
            t.success()
        elif status == "succeeded":
            t.failure(ValueError("install failed but the manager reported success"))

    dev.set_update_oper(on_state)
    mgr = dev.get_swmgr()
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_late_registration_replays_state(t: testing.EnvT):
    """A hook registered after a status change gets the current state at once."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)

    def on_state(oper: ?ygdata.Node) -> None:
        if _pub_status(oper) == "succeeded":
            t.success()

    def register() -> None:
        dev.set_update_oper(on_state)

    mgr = dev.get_swmgr()
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})
    # The mock install completes long before this fires; the only push the
    # hook can get is the replay on registration.
    after 0.05: register()


actor _test_device_already_on_target_does_nothing(t: testing.EnvT):
    """A device that already runs the target is never touched.

    The comparison has to happen before the impacting step. Anything after it
    is too late: the install has already run.
    """
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, NEW)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status == "in-progress" or status == "succeeded":
            t.failure(ValueError("nothing should have been installed, got {status}"))

    def verify() -> None:
        # Under load the manager may not have run yet; wait for the terminal
        # status. The on_state hook still fails the test if an install starts.
        if mgr.get_status() != "up-to-date":
            after 0.05: verify()
            return
        testing.assertEqual(adapter.calls(), ["check"],
                            "only the comparison should have run")
        t.success()

    dev.set_update_oper(on_state)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})
    after 0.05: verify()


actor _test_reached_target_is_not_reinstalled(t: testing.EnvT):
    """Intent restated after a successful upgrade must not install again.

    Measured on a c8000v: sent the sequence a second time, it staged the image,
    accepted the install and reported success -- having changed nothing, which
    afterwards is indistinguishable from a real upgrade.
    """
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def verify() -> None:
        # The second round ends in up-to-date; wait for it under load.
        if mgr.get_status() != "up-to-date":
            after 0.05: verify()
            return
        testing.assertEqual(adapter.calls(),
                            ["check", "prepare", "install", "commit", "check", "check"],
                            "the second round should have stopped at the check")
        t.success()

    def again() -> None:
        # The same intent again, once the first round has finished.
        if mgr.get_status() != "succeeded":
            after 0.05: again()
            return
        mgr.set_config("camp-1", NEW, False, {})
        after 0.05: verify()

    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})
    after 0.05: again()


actor _test_unreadable_release_still_installs(t: testing.EnvT):
    """A read that fails is not evidence that the device is up to date.

    Blocking an upgrade on one failed read would be worse than a redundant
    install, so the manager proceeds without the comparison and says so.
    """
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD, "check")
    dev = _devmgr(t, noop_on_reconf)

    def on_state(oper: ?ygdata.Node) -> None:
        if _pub_status(oper) == "succeeded":
            testing.assertEqual(adapter.calls(), ["check", "prepare", "install", "commit", "check"],
                                "a failed check should not stop the install")
            t.success()

    dev.set_update_oper(on_state)
    mgr = dev.get_swmgr()
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_running_release_is_published(t: testing.EnvT):
    """The oper tree reports what the device said, not what was asked for."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)

    def on_state(oper: ?ygdata.Node) -> None:
        if _pub_status(oper) == "succeeded":
            testing.assertEqual(NEW, _pub_running(oper),
                                "running-release should hold the device's report")
            t.success()

    dev.set_update_oper(on_state)
    mgr = dev.get_swmgr()
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_install_runs_once(t: testing.EnvT):
    """Repeated config does not re-run an install already under way."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def verify() -> None:
        # Wait for the run to finish before counting its calls.
        if mgr.get_status() != "succeeded":
            after 0.05: verify()
            return
        testing.assertEqual(adapter.calls(), ["check", "prepare", "install", "commit", "check"],
                            "the sequence should have run once, not twice")
        t.success()

    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})
    mgr.set_config("camp-1", NEW, False, {})
    mgr.set_config("camp-1", NEW, False, {})
    after 0.05: verify()


actor _test_postchecks_gate_the_commit(t: testing.EnvT):
    """Commit waits for every post-check to pass."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()
    var answered = 0

    def quick(done: action(bool, str) -> None) -> None:
        answered += 1
        done(True, "")

    def slow(done: action(bool, str) -> None) -> None:
        def reply() -> None:
            testing.assertTrue("commit" not in adapter.calls(),
                               "commit must wait for all post-checks")
            answered += 1
            done(True, "")
        after 0.05: reply()

    def verify() -> None:
        if mgr.get_status() != "succeeded":
            after 0.05: verify()
            return
        testing.assertEqual(2, answered, "both post-checks must have run")
        testing.assertEqual(adapter.calls(),
                            ["check", "prepare", "install", "commit", "check"],
                            "commit must follow the passed post-checks")
        t.success()

    mgr.add_postcheck("a", quick)
    mgr.add_postcheck("b", slow)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})
    after 0.05: verify()


actor _test_failed_postcheck_rolls_back(t: testing.EnvT):
    """A failing post-check rolls back instead of committing."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def bad(done: action(bool, str) -> None) -> None:
        done(False, "peer down")

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status == "succeeded":
            t.failure(ValueError("a failed post-check must not end succeeded"))
        elif status == "rolled-back":
            testing.assertEqual(adapter.calls(),
                                ["check", "prepare", "install", "rollback", "check"],
                                "rollback must replace commit")
            testing.assertEqual(OLD, adapter.running(),
                                "device should be back on the old release")
            testing.assertEqual(OLD, _pub_running(oper),
                                "running-release should show the old release")
            t.success()

    dev.set_update_oper(on_state)
    mgr.add_postcheck("a", bad)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_silent_postcheck_rolls_back(t: testing.EnvT):
    """A post-check that never answers counts as failed once the deadline
    passes."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def silent(done: action(bool, str) -> None) -> None:
        pass

    def verify() -> None:
        st = mgr.get_status()
        if st == "in-progress":
            after 0.05: verify()
            return
        testing.assertEqual("rolled-back", st, "deadline must roll back")
        testing.assertTrue("commit" not in adapter.calls(), "no commit without an answer")
        testing.assertTrue("rollback" in adapter.calls(), "rollback must have run")
        t.success()

    mgr.set_postcheck_timeout(0.05)
    mgr.add_postcheck("a", silent)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})
    after 0.05: verify()


actor _test_late_postcheck_reply_is_ignored(t: testing.EnvT):
    """A pass that arrives after the run has rolled back changes nothing."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def bad(done: action(bool, str) -> None) -> None:
        done(False, "peer down")

    def late(done: action(bool, str) -> None) -> None:
        def reply() -> None:
            done(True, "")
        after 0.1: reply()

    def verify() -> None:
        testing.assertEqual("rolled-back", mgr.get_status(),
                            "the late pass must not change the outcome")
        testing.assertTrue("commit" not in adapter.calls(),
                           "the late pass must not commit")
        t.success()

    mgr.add_postcheck("a", bad)
    mgr.add_postcheck("b", late)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})
    after 0.3: verify()


actor _test_removed_postcheck_is_not_consulted(t: testing.EnvT):
    """A removed post-check no longer holds up the commit."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def silent(done: action(bool, str) -> None) -> None:
        pass

    def on_state(oper: ?ygdata.Node) -> None:
        if _pub_status(oper) == "succeeded":
            testing.assertTrue("commit" in adapter.calls(), "commit must have run")
            t.success()

    dev.set_update_oper(on_state)
    mgr.add_postcheck("a", silent)
    mgr.remove_postcheck("a")
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_failed_rollback_is_failed(t: testing.EnvT):
    """When the rollback itself fails the run ends failed, not rolled-back."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD, "rollback")
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def bad(done: action(bool, str) -> None) -> None:
        done(False, "peer down")

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status == "failed":
            t.success()
        elif status == "succeeded" or status == "rolled-back":
            t.failure(ValueError("a failed rollback must end failed, got {status}"))

    dev.set_update_oper(on_state)
    mgr.add_postcheck("a", bad)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_failed_commit_rolls_back(t: testing.EnvT):
    """A refused commit rolls back; the device would revert on its own anyway."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD, "commit")
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status == "rolled-back":
            testing.assertEqual(adapter.calls(),
                                ["check", "prepare", "install", "commit", "rollback", "check"],
                                "a failed commit must be followed by rollback")
            t.success()
        elif status == "succeeded" or status == "failed":
            t.failure(ValueError("a failed commit must roll back, got {status}"))

    dev.set_update_oper(on_state)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_no_commit_window_left_rolls_back(t: testing.EnvT):
    """With less than the commit margin left on the device timer the manager
    does not start post-checks; it aborts."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD, commit_window=30)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()
    var asked = False

    def check(done: action(bool, str) -> None) -> None:
        asked = True
        done(True, "")

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status == "rolled-back":
            testing.assertFalse(asked, "no post-check should run without time to commit")
            testing.assertEqual(adapter.calls(),
                                ["check", "prepare", "install", "rollback", "check"],
                                "rollback must replace commit")
            t.success()
        elif status == "succeeded":
            t.failure(ValueError("must not commit after the device timer"))

    dev.set_update_oper(on_state)
    mgr.add_postcheck("a", check)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_reverted_device_is_not_succeeded(t: testing.EnvT):
    """A commit that reports ok on a device already back on the old release
    ends failed, not succeeded."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD, auto_abort=True)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status == "failed":
            testing.assertEqual(OLD, _pub_running(oper),
                                "running-release must show what the device runs")
            t.success()
        elif status == "succeeded":
            t.failure(ValueError("device on the old release must not be succeeded"))

    dev.set_update_oper(on_state)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})
