cfg3 = gdata.Container({
    q("left"): gdata.Container({
        q("a"): gdata.Leaf(1)
    }),
    q("right"): gdata.Container({
        q("a"): gdata.Leaf(2)
    })
})

out3 = gdata.Container({
    q('devices'): gdata.List([q("id")], [
        gdata.Container({
            q("id"): gdata.Leaf(1),
            q("val"): gdata.Leaf(1)
        }),
        gdata.Container({
            q("id"): gdata.Leaf(2),
            q("val"): gdata.Leaf(2)
        })
    ])
})

class WriteDev(ttt.TransformFunction):
    def transform_wrapper(self, cfg: gdata.Node, linked: gdata.Node, memory, dynstate):
        i = cfg.get_int(q("a"))
        return gdata.Container({
            q('devices'): gdata.List([q("id")], [
                gdata.Container({
                    q("id"): gdata.Leaf(i),
                    q("val"): gdata.Leaf(i)
                })
            ])
        }), None

actor diamond_commit(t: testing.AsyncT):
    stack = ttt.Layer("top",
        ttt.Container({
            q("left"): ttt.Transform(WriteDev),
            q("right"): ttt.Transform(WriteDev)
        }),
        ttt.Sink())

    sess = stack.newsession()

    def cont(_r: value):
        r = sess.below().get()
        testing.assertEqual(r, out3)
        t.success()

    sess.edit_config(cfg3, cont)

