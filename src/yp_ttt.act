"""TTT-backed YANG-push for the northbound NETCONF server.

TttSubscriptionService is the NETCONF binding that serves dynamic YANG-push
(RFC 8641) subscriptions straight from a ttt.Layer datastore via TTT's native
subscription mechanism (declare_subscriptions). On establish-subscription it
declares a TTT subscription and frames what TTT delivers as NETCONF
notifications:

  - a periodic subscription samples the datastore on the spec period, and each
    delivery becomes a push-update carrying the datastore-contents;
  - an on-change subscription is delivered whenever the datastore changes. The
    first delivery is a full push-update baseline (sync-on-start), and every
    delivery after it is a push-change-update carrying an RFC 8072 yang-patch
    of what changed since the last one this subscription was sent.

Supported subset, enforced before a subscription is accepted (anything outside
it gets an rpc-error rather than being silently served as something else):

  - the running or operational datastore;
  - no filter, or a datastore-subtree-filter (RFC 6241 subtree filtering). The
    filter is parsed against the served schema into a gdata filter and handed to
    TTT, which samples only the selected subtree, so each push carries just the
    filtered data. A datastore-xpath-filter is rejected.
  - no dampening-period on an on-change subscription: updates are sent as they
    happen, so a request asking for them to be rate-limited is rejected rather
    than served unthrottled.

Known deviation, still under discussion: TTT periodic subscriptions are
periodic-with-change-suppression, so a periodic subscription only pushes when the
datastore actually changes (at most once per period), not unconditionally every
period.

This belongs at the app layer (it couples netconf to ttt); the mock server keeps
the transport-only netconf.yp binding so it stays TTT-free.
"""

import logging
import std.xml as xml

import ttt
import yang.gdata as gdata
import yang.schema as yschema
import yang.xml as yxml
import yang.ypatch as ypatch

from netconf import Server
import yp


def parse_subtree_filter(schema: yschema.DRoot, nodes: list[xml.Node]) -> gdata.FNode:
    """Turn the data nodes of a datastore-subtree-filter into a gdata filter.

    The nodes are the top-level data nodes carried inside the anydata element,
    so wrap them in the NETCONF <filter> element that from_filter_xml expects.
    Raises ValueError when a node is not in the schema or a value does not
    parse."""
    wrapper = xml.Node("filter", attributes=[("type", "subtree")], children=nodes)
    return yxml.from_filter_xml(schema, wrapper)


class SubState(object):
    """How one accepted subscription is delivered.

    An on-change subscription frames each update as a yang-patch against the
    tree it last sent, so it keeps that tree; a periodic one pushes the whole
    tree every time and keeps no history. synced records whether the baseline
    delivery has happened, which None cannot express: an empty datastore
    delivers a None tree.
    """
    on_change: bool
    sync_on_start: bool
    synced: bool
    last: ?gdata.Node
    seq: int

    def __init__(self, on_change: bool, sync_on_start: bool):
        self.on_change = on_change
        self.sync_on_start = sync_on_start
        self.synced = False
        self.last = None
        self.seq = 0


actor TttSubscriptionService(server: Server, cfs: ttt.Layer, schema: yschema.DRoot,
                             owner_prefix: str="yp",
                             log_handler: ?logging.Handler=None):
    """Serves YANG-push subscriptions for one NETCONF session from cfs.

    Route establish-subscription / delete-subscription here from the server's
    on_rpc (gate with yp.is_subscription_rpc); call shutdown when the session
    closes so TTT stops sampling for it. schema is the served top-level schema;
    subtree filters are parsed against it. owner_prefix must be unique per
    session: TTT keys subscriptions by owner id, so two sessions sharing one cfs
    must not collide."""

    _log = logging.Logger(log_handler)
    var subs: dict[int, SubState] = {}
    var next_id: int = 1

    def _owner_id(sub_id: int) -> str:
        return owner_prefix + "-" + str(sub_id)

    def _datastore_supported(ds: ?str) -> bool:
        # The <datastore> is an identityref, e.g. "ds:operational"; compare the
        # bare identity name.
        if ds is not None:
            local = ds.split(":")[-1]
            return local == "running" or local == "operational"
        return False

    def _contents(tree: ?gdata.Node) -> list[xml.Node]:
        if tree is not None:
            return tree.to_xml(deterministic=True)
        return []

    def _push_update(sub_id: int, tree: ?gdata.Node) -> None:
        server.send_notification(yp.build_notification(
            yp.event_time_now(), yp.build_push_update(sub_id, _contents(tree))))

    def _on_tree(sub_id: int, tree: ?gdata.Node, err: ?Exception) -> None:
        """TTT subscription callback: a fresh merged tree (or an error).

        Frame it for this subscription's delivery mode, unless the subscription
        is already gone."""
        if sub_id not in subs:
            return
        st = subs[sub_id]
        if err is not None:
            _log.error("subscription sample error id={sub_id} error={err}")
            return
        if not st.on_change:
            _push_update(sub_id, tree)
            return
        # An empty datastore arrives as None; diffing wants a tree either way.
        new_tree = tree if tree is not None else gdata.Container()
        if not st.synced:
            # Nothing has been sent yet, so there is no state at the receiver to
            # patch against: send the whole tree, or nothing if the subscriber
            # asked for deltas only.
            st.synced = True
            st.last = new_tree
            subs[sub_id] = st
            if st.sync_on_start:
                _push_update(sub_id, tree)
            return
        d = gdata.diff(st.last, new_tree)
        st.last = new_tree
        st.seq += 1
        subs[sub_id] = st
        if d is not None:
            patch = ypatch.diff_to_patch(d, "s{sub_id}-{st.seq}")
            server.send_notification(yp.build_notification(
                yp.event_time_now(), yp.build_push_change_update(sub_id, patch.to_xml())))

    def _establish(message_id: str, st: SubState, period_s: ?float,
                   subtree_filter: ?list[xml.Node], mode: str) -> None:
        """Accept a subscription: allocate an id, answer, then start delivery.

        A subtree filter that does not parse against the schema fails the RPC
        with invalid-value, and no id is allocated. The reply carries the id the
        notifications will reference, so it is sent before the subscription is
        declared and can push (ordering)."""
        filt: ?gdata.FNode = None
        if subtree_filter is not None:
            try:
                filt = parse_subtree_filter(schema, subtree_filter)
            except Exception as e:
                server.send_error(message_id, "invalid-value",
                    "bad datastore-subtree-filter: {e}")
                return
        sub_id = next_id
        next_id += 1
        subs[sub_id] = st
        scope = "filtered" if filt is not None else "full"
        _log.info("establish-subscription id={sub_id} mode={mode} scope={scope}")
        server.send_reply(message_id, [yp.build_subscription_id_reply(sub_id)])
        if st.on_change:
            spec = gdata.SubscriptionSpec(filt, on_change=True)
        else:
            spec = gdata.SubscriptionSpec(filt, period=period_s)
        cfs.declare_subscriptions(_owner_id(sub_id),
            (lambda tree, err: _on_tree(sub_id, tree, err)), {spec})

    def handle_rpc(message_id: str, op: xml.Node) -> None:
        """Handle a subscription RPC. Route here when is_subscription_rpc."""
        if op.tag == "establish-subscription":
            params = yp.parse_establish_subscription(op)
            pp = params.periodic_period
            dp = params.dampening_period
            # Enforce the supported subset before allocating an id, so unsupported
            # request shapes fail closed instead of being served as something else.
            if not _datastore_supported(params.datastore):
                server.send_error(message_id, "invalid-value",
                    "unsupported datastore; this server serves running and operational")
            elif params.xpath_filter is not None:
                server.send_error(message_id, "operation-not-supported",
                    "xpath filters are not supported; use a datastore-subtree-filter")
            elif params.on_change:
                if dp is not None and dp > 0:
                    server.send_error(message_id, "operation-not-supported",
                        "<dampening-period> is not supported; on-change updates are sent as they happen")
                else:
                    _establish(message_id, SubState(True, params.sync_on_start),
                        None, params.subtree_filter, "on-change")
            elif pp is not None:
                if pp <= 0:
                    server.send_error(message_id, "invalid-value",
                        "<period> must be a positive number of centiseconds")
                else:
                    period_s = float(pp) / 100.0
                    _establish(message_id, SubState(False, True), period_s,
                        params.subtree_filter, "periodic period={period_s}s")
            else:
                server.send_error(message_id, "missing-element",
                    "a periodic <period> or an <on-change> is required")
        elif op.tag == "delete-subscription":
            did = yp.parse_delete_subscription(op)
            ok = False
            if did is not None:
                if did in subs:
                    cfs.remove_subscriptions(_owner_id(did))
                    del subs[did]
                    _log.info("delete-subscription id={did}")
                    ok = True
            if ok:
                server.send_ok(message_id)
            else:
                server.send_error(message_id, "invalid-value", "no such subscription")
        else:
            server.send_error(message_id, "operation-not-supported", "unsupported subscription RPC: " + op.tag)

    def shutdown() -> None:
        """Release every subscription for this session (call on disconnect) so
        TTT stops sampling on our behalf."""
        n = len(subs)
        for sid in subs.keys():
            cfs.remove_subscriptions(_owner_id(sid))
        subs = {}
        if n > 0:
            _log.info("stopping all subscriptions (count={n})")
