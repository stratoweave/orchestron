#!/usr/bin/env python3
# StratoWeave classic ZTP day-0 script (IOS-XE), device rtr2
import cli
import urllib.request

def report(ptype, message):
    try:
        urllib.request.urlopen("http://192.0.2.1:80/ztp/v1/device/rtr2/progress?type=" + ptype + "&message=" + message, timeout=5)
    except Exception:
        pass

report("bootstrap-initiated", "day0-script-started")
report("config-initiated", "applying-day0-config")
cli.configurep(["hostname rtr2", "username admin privilege 15 secret 0 admin", "aaa new-model", "aaa authentication login default local", "aaa authorization exec default local", "interface GigabitEthernet1", "ip address dhcp", "no shutdown", "netconf-yang", "line vty 0 4", "login local", "transport input all", "end"])
report("config-complete", "day0-config-applied")
cli.execute("write memory")
report("bootstrap-complete", "day0-script-finished")
