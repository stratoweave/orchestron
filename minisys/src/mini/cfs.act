import logging

import yang.adata as yadata
import yang.gdata as ygdata # required for linked input parameter to transform function
import stratoweave.ttt as ttt
import stratoweave.ipam as ipam
import stratoweave.ztp.dhcp as ztpdhcp

import mini.layers.base_0 as base
import mini.layers.y_0 as y_0
# TODO: this import is required by the compiler, maybe related to
# https://github.com/actonlang/acton/issues/2390
import yang.identityref
import mini.layers.y_0_oper as y0_oper
import mini.layers.y_1_oper as y1_oper

# Base block out of which onboarding /31 access links are carved. A real
# resource manager will own this; for now ztp-onboarding/link-index selects
# the link deterministically.
ZTP_ONBOARDING_BLOCK = "10.64.0.0"

# StratoWeave's own bootstrap server, as reachable by a booting CPE (routed via
# its PE). Deployment fact; hard-coded for the demo. This is the sweave node's
# address on the quicklab-ztp management network, so a PE lab built on that
# topology reaches the same server the CPE is pointed at.
SZTP_BOOTSTRAP_HTTPS = "https://172.31.255.10"
SZTP_BOOTSTRAP_HTTP = "http://172.31.255.10"

class ZtpOnboarding(base.ZtpOnboarding):
    """Onboard a CPE via an inline DHCP server on a PE port.

    Allocates the /31 access link deterministically from the link-index,
    creates the CPE device meta-config with the *far* /31 end as its
    management address (known up front — no discovery needed), and adds a
    dhcp-onboarding service to the PE's RFS so the PE is configured to serve
    SZTP bootstrapping data to the CPE on that link.
    """
    def transform(self, i):
        o = base.o_root()

        # Deterministic /31: a = PE end, b = CPE end
        link = ipam.nth_p2p(ZTP_ONBOARDING_BLOCK, 31, int(i.link_index))

        # The CPE device — its management address IS the far end of the /31,
        # so StratoWeave knows where to reach it without any discovery step.
        cpe = o.device.create(i.name)
        cpe.type = "xr"
        cpe.approval_required = False
        cpe.ztp.enabled = True
        # ZTP-as-a-Service: when onboard-only, StratoWeave brings the device
        # to day-0 and then forgets it (the upstream orchestrator manages it).
        cpe.ztp.onboard_only = i.onboard_only
        serial = i.serial
        if serial is not None:
            cpe.ztp.serial_number = serial
        # The day-0 credentials are inputs from the upstream orchestrator;
        # StratoWeave renders the actual per-OS day-0 config from them.
        cpe.credentials.username = i.username
        cpe.credentials.password = i.password
        # The CPE's management address is the far end of the /31, known up
        # front (deterministic) — no discovery. For an onboard-only device the
        # NoAdapter means it is never connected despite having an address.
        cpe_addr = cpe.address.create("oob")
        cpe_addr.address = link.b_address

        # The PE-side DHCP service. The DHCP option (143 SZTP redirect) is the
        # standardized value from the platform helper; rendering it into the
        # PE's vendor config is the RFS transform's job.
        opt = ztpdhcp.sztp_redirect_option(SZTP_BOOTSTRAP_HTTPS)
        rfs = o.rfs.create(i.pe)
        dho = rfs.dhcp_onboarding.create(
            i.pe_interface,
            pe_address=link.a_address,
            cpe_address=link.b_address,
            prefix_len=u64(31),
            pool_name="ONBOARD-{i.name}",
            profile_name="ONBOARD-{i.name}",
            option_code=u64(opt.code),
            option_hex=opt.value,
        )

        return o


class DhcpServer(base.DhcpServer):
    """Create a managed DHCP server as a device, and render its scopes.

    The server is a StratoWeave device like a router is. Each scope becomes
    one dhcp-scope service in the server's RFS. Each router that onboards
    through the server adds its own reservation to the same scope (see
    Router). The two services merge into one device configuration.
    """
    def transform(self, i):
        o = base.o_root()

        dev = o.device.create(i.name)
        dev.type = i.type
        dev.approval_required = False
        dev.mock.enabled = i.mock
        api = dev.address.create("control-channel")
        api.address = i.address
        api.port = i.port
        # Every device holds a user name, so the name of the server is the
        # fallback. The password stays unset for a server that does not
        # authenticate, and the adapter then sends no credentials.
        username = i.username
        dev.credentials.username = username if username is not None else i.name
        dev.credentials.password = i.password

        rfs = o.rfs.create(i.name)
        for scope in i.scope:
            s = rfs.dhcp_scope.create(
                scope.id,
                subnet=scope.subnet,
                pool="{scope.pool_start}-{scope.pool_end}",
                valid_lifetime=scope.valid_lifetime,
                gateway=scope.gateway,
                interface=scope.interface,
            )
            # The scope is the ZTP bucket: it sends the SZTP redirect to
            # every client in it. The option value is the standardized one
            # from the platform helper.
            if scope.sztp:
                s.sztp_redirect_uri = SZTP_BOOTSTRAP_HTTPS

        return o


class GlobalSettings(base.GlobalSettings):
    def transform(self, i):
        o = base.o_root()
        return o


class PContainer(base.PContainer):
    def transform(self, i):
        o = base.o_root()
        return o


actor RouterTransform(path: ttt.Path, update_dynstate: proc(?y_0.netinfra__netinfra__router__dynstate)->None, update_oper: proc(?y0_oper.netinfra__netinfra__router_entry)->None, lower_tree_provider: ?ygdata.TreeProvider):
    oper = base.Router.new_state(path)
    _subs = ygdata.SubscriptionManager(lower_tree_provider!, str(path))

    def on_rfs_state(root: ?y1_oper.root, err: ?Exception, router_name: str):
        if err is not None:
            print("RouterTransform RFS subscription error: {err}", err=True)
            return

        r = root!.rfs.get(router_name)
        if r is not None:
            oper.state.current_datetime = r.base_config?.state.current_datetime
        update_oper(oper)

    def subscribe(router_name: str):
        want: set[ygdata.Delivery] = set()
        dst = y1_oper.dst(lambda r, e: on_rfs_state(r, e, router_name))
        rfs = y1_oper.subs.rfs.entry(router_name)
        want.add(dst.deliver({
            rfs.base_config.state.current_datetime.subscribe(period=1.0)
        }))
        _subs.declare(want)

    def on_conf(conf: y_0.netinfra__netinfra__router_entry):
        subscribe(conf.name)

class Router(base.Router):
    def transform(self, i, linked, dynstate):
        asn = y_0.root.from_gdata(linked).netinfra.global_settings.asn

        o = base.o_root()
        print("CFS router transform running", i.name)
        dev = o.device.create(i.name)
        dev.type = i.type
        dev.approval_required = False
        if i.ztp:
            # No address is configured for ZTP routers: StratoWeave learns
            # the management address from the bootstrap exchange
            dev.ztp.enabled = True
            ztp_serial = i.ztp_serial
            if ztp_serial is not None:
                dev.ztp.serial_number = ztp_serial
        else:
            oob_addr = dev.address.create("oob")
            oob_addr.address = i.name
        dev.credentials.username = "admin"
        dev.credentials.password = "admin"
        dev.mock.enabled = i.mock

        rfs = o.rfs.create(i.name)
        bc = rfs.base_config
        hostname = i.hostname
        router_name = hostname if hostname is not None else i.name
        bc.name = router_name
        bc.ipv4_address = "10.0.0.{i.id}"

        ztp_dhcp = i.ztp_dhcp
        if ztp_dhcp is not None:
            zd = ztp_dhcp!
            # The reservation fixes the address, so StratoWeave knows where
            # to reach the router before the router boots. It does not have
            # to learn the address from the bootstrap exchange.
            oob_addr = dev.address.create("oob")
            oob_addr.address = zd.address

            dhcp = o.rfs.create(zd.server)
            res = dhcp.dhcp_reservation.create(
                i.name,
                scope=zd.scope,
                mac_address=zd.mac_address,
                address=zd.address,
                hostname=router_name,
            )
            # Classic ZTP identifies the router by the URL that it fetches,
            # so the boot file is per router. The scope sends the SZTP
            # redirect, which is the same for every client.
            if i.ztp:
                res.bootfile_url = ztpdhcp.classic_bootfile_url(
                    i.name, SZTP_BOOTSTRAP_HTTP)

        return o


class L3vpn(base.L3vpn):
    def transform(self, i, linked):
        linked_adata = y_0.root.from_gdata(linked)
        asn = linked_adata.netinfra.global_settings.asn

        o = base.o_root()
        print("CFS l3vpn transform running", i.name, "asn:", asn)
        rt = "target:65000:{i.vpn_id}"

        for endpoint in i.endpoint:
            router = linked_adata.netinfra.router.get(endpoint.device)!
            rd = "{router.id}:{i.vpn_id}"
            rfs_dev = o.rfs.create(endpoint.device)
            description = endpoint.description
            if description is None:
                description = i.description
            mtu = endpoint.mtu
            if mtu is None:
                mtu = i.service_mtu

            rfs_endpoint = rfs_dev.l3vpn_endpoint.create(
                endpoint.interface_name,
                vpn_name            = i.name,
                customer_name       = i.customer_name,
                route_distinguisher = rd,
                import_rt           = rt,
                export_rt           = rt,
                ipv4_address        = endpoint.ipv4_address,
                prefix_length       = endpoint.prefix_length,
                mtu                 = mtu,
                enabled             = i.enabled and endpoint.enabled,
            )
            rfs_endpoint.vlan_id     = endpoint.vlan_id
            rfs_endpoint.site_code   = endpoint.site_code
            rfs_endpoint.description = description

        return o
