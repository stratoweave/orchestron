            return
        if n is not None:
            cb(root.from_gdata(n), None)
            return
        cb(None, None)

proc def dst(cb: action(?root, ?Exception) -> None) -> ygdata.Dst:
    adapter = DstAdapter(cb)
    return ygdata.Dst(adapter.on_update)
