    DContainer(module='Cisco-IOS-XR-ip-daps-cfg', namespace='http://cisco.com/ns/yang/Cisco-IOS-XR-ip-daps-cfg', prefix='ip-daps-cfg', name='networks', config=True, description='Specify network for allocation', presence=False, children=[
