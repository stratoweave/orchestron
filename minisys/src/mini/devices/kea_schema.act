'identifier'
    ], config=True, description='The per-host reservations in this scope. ZTP uses a reservation\nfor the deterministic half of onboarding. StratoWeave knows the\n/31 CPE address when it allocates the link. The reservation then\nbinds the device that boots to that address. The reservation\nalso carries the per-device classic-ZTP bootfile URL.', min_elements=0, ordered_by='system', children=[
    DLeaf(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='identifier-type', config=True, description="The Kea host identifier that 'identifier' holds.", mandatory=False, type=DTypeEnum(name='enumeration', description=None, reference=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'hw-address':0, 'client-id':1, 'circuit-id':2, 'duid':3, 'flex-id':4})),
    DLeaf(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='identifier', config=True, description="The identifier value. A 'hw-address' is hex with colons. A\n'circuit-id', a 'duid' and a 'flex-id' are hex strings.\n\nCANONICAL FORM: Kea removes the colons from a 'client-id'. Kea\nreturns '01:02:03:04:05' as '0102030405'. The adapter converts\nto Kea's form before it compares. A reservation in either form\nthus gives the same key.", mandatory=False, type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])),
    DLeaf(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='ip-address', config=True, description='The address that Kea reserves for this host.', mandatory=False, type=DTypeString(name='inet:ipv4-address', description='The ipv4-address type represents an IPv4 address in\ndotted-quad notation.  The IPv4 address may include a zone\nindex, separated by a % sign.\n\nThe zone index is used to disambiguate identical address\nvalues.  For link-local addresses, the zone index will\ntypically be the interface index number or the name of an\ninterface.  If the zone index is not present, the default\nzone of the device will be used.\n\nThe canonical format for the zone index is the numerical\nformat', reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%[\\p{{N}}\\p{{L}}]+)?', pcre='^((([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%[\\p{{N}}\\p{{L}}]+)?)$', invert=False)])),
    DLeaf(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='hostname', config=True, default='', mandatory=False, type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])),
    DLeaf(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='next-server', config=True, description='The siaddr field. It gives this host the address of the boot\nserver.', default='0.0.0.0', mandatory=False, type=DTypeString(name='inet:ipv4-address', description='The ipv4-address type represents an IPv4 address in\ndotted-quad notation.  The IPv4 address may include a zone\nindex, separated by a % sign.\n\nThe zone index is used to disambiguate identical address\nvalues.  For link-local addresses, the zone index will\ntypically be the interface index number or the name of an\ninterface.  If the zone index is not present, the default\nzone of the device will be used.\n\nThe canonical format for the zone index is the numerical\nformat', reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%[\\p{{N}}\\p{{L}}]+)?', pcre='^((([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%[\\p{{N}}\\p{{L}}]+)?)$', invert=False)])),
    DLeaf(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='server-hostname', config=True, description='The sname field.', default='', mandatory=False, type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])),
    DLeaf(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='boot-file-name', config=True, description='The file field, which is also option 67. Classic ZTP puts the\nper-device bootfile URL here. StratoWeave serves that URL. A\nclassic-ZTP device identifies itself by the URL that it\nfetches.', default='', mandatory=False, type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])),
    DLeafList(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='client-classes', config=True, description='The classes that Kea assigns to this host.', min_elements=0, ordered_by='system', type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])),
    DList(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='option-data', key=[
'space',
'code'
        ], config=True, description='The DHCP options that Kea serves at this scope. Kea identifies\nan option by its space and its code. This list uses the same\ntwo values as its key.', min_elements=0, ordered_by='system', children=[
        DLeaf(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='space', config=True, description="The option space that holds the code. 'dhcp4' is the standard\nv4 space. A vendor space such as\n'vendor-encapsulated-options-space' holds sub-options. Kea\nuses 'dhcp4' as the default. A list key cannot hold a default,\nso each entry must give this value. 'config-get' also returns\nthis value in each entry.", mandatory=False, type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])),
        DLeaf(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='code', config=True, description="The DHCP option code. The StratoWeave ZTP option helper uses\ncodes and not names. Code 143 is the RFC 8572 SZTP redirect.\nCode 67 is the classic bootfile. Code 66 is the TFTP server.\nCode 43 is Cisco PnP. A code that Kea does not know needs an\n'option-def' entry in the operator's own configuration.", mandatory=False, type=DTypeIntegerUnsigned(name='uint16', description=None, reference=None, exts=[], builtin_type='uint16', default=None, ranges=Ranges([(0, 65535)]))),
        DLeaf(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='data', config=True, description="The option value. Kea reads this value as a list of the\noption's typed fields when 'csv-format' is true. Kea reads it\nas a hex string when 'csv-format' is false. The RFC 8572\nbootstrap-server list is a raw tuple encoding. It needs\n'csv-format' false.", mandatory=False, type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])),
        DLeaf(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='csv-format', config=True, description="Read 'data' as the list of typed fields of the option. Read\n'data' as hex when this leaf is false.", default='true', mandatory=False, type=DTypeBoolean(name='boolean', description=None, reference=None, exts=[], builtin_type='boolean', default=None)),
        DLeaf(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='always-send', config=True, description='Send the option even when the client does not request it. The\nZTP options need this behaviour. A device that boots does not\nalways request code 143 or code 67.', default='false', mandatory=False, type=DTypeBoolean(name='boolean', description=None, reference=None, exts=[], builtin_type='boolean', default=None)),
        DLeaf(module='kea-dhcp4', namespace='http://stratoweave.org/yang/kea-dhcp4', prefix='kea4', name='never-send', config=True, description='Do not send the option, even when the client requests it.', default='false', mandatory=False, type=DTypeBoolean(name='boolean', description=None, reference=None, exts=[], builtin_type='boolean', default=None))
    ])
])

