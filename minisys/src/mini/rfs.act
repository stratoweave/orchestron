import logging
import random
import yang.adata as yadata
import yang.gdata as gdata
import stratoweave.device as swdev
import stratoweave.ttt as ttt
from stratoweave.exception import UnsupportedDevice

import mini.layers.base_1 as base
from mini.layers.y_1 import stratoweave_rfs__rfs__base_config__dynstate as BaseConfigDynstate
import mini.layers.y_1 as y1
import mini.layers.y_1_oper as y1_oper

import mini.devices.ietf as ietf_dev
import mini.devices.ietf_oper as ietf_oper
import mini.devices.xr as xr_dev
from mini.devices.ietf_oper import root as ietf_oper_root


class BaseConfig(base.BaseConfig):
    def transform(self, i, di, dynstate: ?BaseConfigDynstate):
        print("RFS /rfs{{{di.name}}}/base-config transform running", err=True)

        if "ietf-system" in di.modules:
            dev = ietf_dev.root()
            dev.system.hostname = i.name
            if dynstate is not None:
                current_datetime = dynstate.current_datetime
                if current_datetime is not None:
                    dev.system.contact = current_datetime

            return dev

        if "Cisco-IOS-XR-um-hostname-cfg" in di.modules:
            xdev = xr_dev.root()
            xdev.hostname.system_network_name = i.name
            return xdev

        raise UnsupportedDevice()


class DhcpOnboarding(base.DhcpOnboarding):
    """Render an inline DHCP-server config onto a PE for CPE onboarding.

    Produces, for an IOS-XR PE: a DHCP server profile bound to the access
    interface, serving the onboarding option (e.g. SZTP redirect / option
    143) and pointing default-router at the PE end of the /31. The pool
    network and the interface /31 address are PE base infrastructure
    (provisioned with the access link); StratoWeave adds the onboarding
    DHCP service on top.
    """
    def transform(self, i, di):
        print("RFS dhcp-onboarding transform running", di.name, i.pe_interface, err=True)

        if "Cisco-IOS-XR-ipv4-dhcpd-cfg" in di.modules:
            dev = xr_dev.root()
            dhcpd = dev.create_ipv4_dhcpd()

            # server profile: pool + default-router + the onboarding option
            prof = dhcpd.profiles.profile.create(i.profile_name)
            mode = prof.modes.mode.create("server")
            srv = mode.create_server(pool=i.pool_name)
            srv.default_routers.default_router.append(i.pe_address)
            srv.option_codes.option_code.create(i.option_code, hex_string=i.option_hex)

            # bind the profile to the access interface
            intf = dhcpd.interfaces.interface.create(i.pe_interface)
            intf.create_profile(profile_name=i.profile_name, mode="server")

            return dev

        raise UnsupportedDevice()


actor BaseConfigTransform(path, update_dynstate: proc(?BaseConfigDynstate)->None, update_oper: proc(?y1_oper.stratoweave_rfs__rfs__base_config)->None, dev: swdev.DeviceMgr):
    _subs = gdata.SubscriptionManager(dev.tree_provider(), str(path))
    _dynstate = base.BaseConfig.dynstate_type()()
    _oper = base.BaseConfig.new_state(path)

    def publish():
        _oper.state.current_datetime = "rfs-{random.randint(0, 999999)}"
        update_oper(_oper)
        after 1: publish()

    after 0: publish()

    def on_state(root: ?ietf_oper_root, err: ?Exception):
        if err is not None:
            print("BaseConfigTransform subscription error: {err}", err=True)
            return
        _dynstate.current_datetime = root?.system_state?.clock?.current_datetime
        update_dynstate(_dynstate)

    def on_conf(conf: y1.stratoweave_rfs__rfs__base_config):
        want: set[gdata.Delivery] = set()
        if "ietf-system" in dev.get_modules().0:
            state_dst = ietf_oper.dst(on_state)
            want.add(state_dst.deliver({
                ietf_oper.subs.system_state.clock.subscribe(period=0.01)
            }))
        _subs.declare(want)


class L3vpnEndpoint(base.L3vpnEndpoint):
    def transform(self, i: y1.stratoweave_rfs__rfs__l3vpn_endpoint_entry, di):
        print("RFS l3vpn-endpoint transform running", di.name, i.vpn_name, i.interface_name, err=True)

        if "ietf-interfaces" in di.modules and "ietf-ip" in di.modules:
            dev = ietf_dev.root()
            interface_type = ietf_dev.iana_if_type_ethernetCsmacd
            if i.interface_name.startswith("lo"):
                interface_type = ietf_dev.iana_if_type_softwareLoopback
            elif i.vlan_id is not None or "." in i.interface_name:
                interface_type = ietf_dev.iana_if_type_l3ipvlan

            description = i.description! if i.description is not None else "{i.customer_name} vpn {i.vpn_name}"
            if i.description is None:
                if i.site_code is not None:
                    description += " site {i.site_code}"
                else:
                    description += " interface {i.interface_name}"
                if i.vlan_id is not None:
                    description += " vlan {i.vlan_id}"
            description += " rd {i.route_distinguisher}"

            iface = dev.interfaces.interface.create(
                i.interface_name,
                description=description,
                type=interface_type,
                enabled=i.enabled,
            )
            ipv4 = iface.create_ipv4(enabled=i.enabled, forwarding=True, mtu=i.mtu)
            ipv4.address.create(i.ipv4_address, prefix_length=i.prefix_length)

            return dev

        raise UnsupportedDevice()
