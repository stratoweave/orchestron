module netinfra {
  yang-version "1.1";
  namespace "http://example.com/netinfra";
  prefix "netinfra";
  description "Network Infrastructure";
  revision 2019-01-01 {
    description "test revision";
    reference "ref1";
  }
  import stratoweave {
    prefix sw;
  }

  container netinfra {
    description "Network infrastructure";
    container global-settings {
      sw:transform mini.cfs.GlobalSettings;
      leaf asn {
        type uint32;
      }
    }
    list ztp-onboarding {
      description "Onboard a CPE via an inline DHCP server on a PE port.";
      key name;

      sw:transform mini.cfs.ZtpOnboarding;

      leaf name {
        description "Name of the CPE device to onboard and create";
        type string;
      }
      leaf serial {
        description "CPE bootstrap identity (SZTP serial); defaults to name";
        type string;
      }
      leaf pe {
        description "PE router that hosts the inline DHCP server";
        type string;
        mandatory true;
      }
      leaf pe-interface {
        description "PE interface facing the CPE (the /31 access link)";
        type string;
        mandatory true;
      }
      leaf link-index {
        description
          "Index of the /31 onboarding link within the onboarding block.
          Deterministically maps to a PE/CPE address pair. A real resource
          manager will assign this; for now it is supplied in config.";
        type uint32;
        mandatory true;
      }
      leaf username {
        description "Day-0 credential the device comes up with (supplied by
          the upstream orchestrator; StratoWeave renders the per-OS config)";
        type string;
        default "admin";
      }
      leaf password {
        type string;
        default "admin";
      }
      leaf onboard-only {
        description "ZTP-as-a-Service: bring the device to day-0 then forget
          it (StratoWeave never manages it; the upstream orchestrator does)";
        type boolean;
        default "false";
      }
    }

    list router {
      key name;

      sw:transform mini.cfs.Router;
      sw:link global {
        sw:path /netinfra/global-settings;
      }

      leaf name {
        type string;
      }
      leaf id {
        type uint32;
        description "router id";
        mandatory true;
      }
      leaf type {
        type string;
        mandatory true;
      }
      leaf mock {
        type boolean;
        default false;
      }
      leaf ztp {
        description "Onboard this router with Zero Touch Provisioning: no
          management address is configured; StratoWeave offers bootstrapping
          data and learns the address from the bootstrap exchange.";
        type boolean;
        default false;
      }
      leaf hostname {
        description "Hostname configured on the router, defaults to the
          router name";
        type string;
      }
      leaf ztp-serial {
        description "Bootstrap identity (serial number) of the router,
          defaults to the router name";
        type string;
      }
      container dynstate {
        sw:dynstate;
        leaf current-datetime {
          type string;
        }
      }
      container state {
        config false;
        leaf current-datetime {
          type string;
        }
      }
    }

  }
  // This transform does nothing, just used for testing transform point in P-container
  container p-container {
    presence maybe;
    sw:transform mini.cfs.PContainer;
  }
}
